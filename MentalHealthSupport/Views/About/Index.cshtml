@model MentalHealthSupport.Models.ViewModel.AboutUsViewModel

@{
    ViewData["Title"] = Model?.Title ?? "Về Chúng Tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-shell">
    <div class="container">
        <div class="hero-card p-4 p-lg-5 mb-5 about-hero-card">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-heart-pulse"></i>
                        Đồng hành cùng sức khỏe tinh thần
                    </span>

                    <h1 class="display-5 fw-bold mb-3">
                        @(string.IsNullOrWhiteSpace(Model?.HeroHeading) ? "Về Chúng Tôi" : Model!.HeroHeading)
                    </h1>

                    <p class="fs-5 section-subtitle mb-4">
                        @(string.IsNullOrWhiteSpace(Model?.HeroDescription)
                            ? "Chúng tôi tin rằng mọi người đều xứng đáng có được sức khỏe tinh thần tốt và sự hỗ trợ chuyên nghiệp khi cần thiết."
                            : Model!.HeroDescription)
                    </p>

                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <a asp-controller="Consultants" asp-action="Index" class="btn btn-primary btn-lg">
                            Tìm chuyên gia
                        </a>
                        <a asp-controller="Appointments" asp-action="MyAppointments" class="btn btn-outline-primary btn-lg">
                            Xem lịch hẹn
                        </a>
                    </div>

                    <div class="row g-3 about-mini-stats">
                        <div class="col-6 col-md-4">
                            <div class="hero-stat-card">
                                <h4>24/7</h4>
                                <p>Hỗ trợ liên tục</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="hero-stat-card">
                                <h4>99,9%</h4>
                                <p>Bảo mật thông tin</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="hero-stat-card">
                                <h4>30+</h4>
                                <p>Chuyên gia tâm lý</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 text-center">
                    <div class="about-hero-image-wrap">
                        @if (Model != null && !string.IsNullOrWhiteSpace(Model.HeroImageUrl))
                        {
                            <img src="~/images/@Model.HeroImageUrl"
                                 asp-append-version="true"
                                 alt="Về chúng tôi"
                                 class="img-fluid about-hero-image" />
                        }
                        else
                        {
                            <div class="about-hero-placeholder">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="page-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h2 class="section-title mb-2">
                    @(string.IsNullOrWhiteSpace(Model?.MissionHeading) ? "Sứ Mệnh Của Chúng Tôi" : Model!.MissionHeading)
                </h2>
                <p class="section-subtitle mb-0">
                    Những định hướng cốt lõi giúp nền tảng mang đến trải nghiệm hỗ trợ tâm lý an toàn và hiệu quả.
                </p>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-4">
                <div class="feature-card p-4 h-100 about-mission-card">
                    <div class="about-icon-circle mb-3">🤝</div>
                    <h5 class="fw-bold">Kết nối và hỗ trợ</h5>
                    <p class="section-subtitle mb-0">
                        Tạo cầu nối giữa người cần hỗ trợ tâm lý và đội ngũ chuyên gia phù hợp, mang đến sự đồng hành đúng lúc.
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="feature-card p-4 h-100 about-mission-card">
                    <div class="about-icon-circle mb-3">🧠</div>
                    <h5 class="fw-bold">Chăm sóc tinh thần</h5>
                    <p class="section-subtitle mb-0">
                        Hướng đến một môi trường hỗ trợ tích cực, nơi người dùng có thể cải thiện sức khỏe tinh thần bền vững hơn.
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="feature-card p-4 h-100 about-mission-card">
                    <div class="about-icon-circle mb-3">🔒</div>
                    <h5 class="fw-bold">Bảo mật và ẩn danh</h5>
                    <p class="section-subtitle mb-0">
                        Đảm bảo tính riêng tư trong quá trình trao đổi, giúp người dùng yên tâm chia sẻ và tìm kiếm sự hỗ trợ.
                    </p>
                </div>
            </div>
        </div>

        <div class="page-hero mb-4">
            <h2 class="section-title mb-2">
                @(string.IsNullOrWhiteSpace(Model?.ValuesHeading) ? "Giá Trị Cốt Lõi" : Model!.ValuesHeading)
            </h2>
            <p class="section-subtitle mb-0">
                Những nguyên tắc định hình cách chúng tôi xây dựng trải nghiệm cho người dùng.
            </p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-6 col-xl-3">
                <div class="feature-card p-4 text-center h-100 about-value-card">
                    <div class="about-value-emoji mb-3">❤️</div>
                    <h5 class="fw-bold">Tính nhân văn</h5>
                    <p class="section-subtitle mb-0">
                        Đặt con người là trung tâm, thấu hiểu và đồng cảm với mọi khó khăn tâm lý.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="feature-card p-4 text-center h-100 about-value-card">
                    <div class="about-value-emoji mb-3">🛡️</div>
                    <h5 class="fw-bold">Chuyên nghiệp</h5>
                    <p class="section-subtitle mb-0">
                        Đội ngũ chuyên gia được đào tạo bài bản, có chuyên môn và kinh nghiệm hỗ trợ thực tế.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="feature-card p-4 text-center h-100 about-value-card">
                    <div class="about-value-emoji mb-3">🔐</div>
                    <h5 class="fw-bold">Bảo mật</h5>
                    <p class="section-subtitle mb-0">
                        Cam kết bảo vệ thông tin cá nhân và quyền riêng tư trong suốt quá trình sử dụng hệ thống.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="feature-card p-4 text-center h-100 about-value-card">
                    <div class="about-value-emoji mb-3">🚀</div>
                    <h5 class="fw-bold">Đổi mới</h5>
                    <p class="section-subtitle mb-0">
                        Không ngừng cập nhật công nghệ và cách tiếp cận hiện đại để nâng cao chất lượng hỗ trợ.
                    </p>
                </div>
            </div>
        </div>

        <div class="home-cta-section">
            <div class="app-card p-4 p-lg-5 text-center about-cta-card">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-stars"></i>
                    Bắt đầu ngay hôm nay
                </span>
                <h2 class="section-title mb-3">
                    @(string.IsNullOrWhiteSpace(Model?.CallToActionHeading)
                        ? "Bắt Đầu Hành Trình Chăm Sóc Tâm Lý"
                        : Model!.CallToActionHeading)
                </h2>
                <p class="section-subtitle mb-4 mx-auto home-cta-text">
                    @(string.IsNullOrWhiteSpace(Model?.CallToActionDescription)
                        ? "Đừng để những khó khăn tâm lý cản trở cuộc sống của bạn. Hãy để chúng tôi đồng hành cùng bạn trên con đường tìm lại sự cân bằng và hạnh phúc."
                        : Model!.CallToActionDescription)
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Consultants" asp-action="Index" class="btn btn-primary btn-lg">
                        Tìm chuyên gia
                    </a>
                    <a asp-controller="News" asp-action="Index" class="btn btn-outline-primary btn-lg">
                        Xem bài viết
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>