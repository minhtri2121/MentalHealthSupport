@model List<MentalHealthSupport.Models.ViewModel.ConsultantReviewViewModel>

@{
    ViewData["Title"] = "Đánh giá chuyên gia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Đánh giá chuyên gia</h2>
        <a asp-controller="Consultants" asp-action="Details" asp-route-id="@ViewBag.ConsultantId" class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">Chuyên gia này chưa có đánh giá nào.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>@item.UserName</strong>
                                <small class="text-muted">@item.RatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>

                            <div class="mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Rating)
                                    {
                                        <span class="text-warning fs-5">★</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary fs-5">☆</span>
                                    }
                                }
                            </div>

                            <p class="mb-0">@item.Comment</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>