@model List<ChatMessageViewModel>

@{
    ViewData["Title"] = "Chi tiết trò chuyện";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUserId = Context.Session.GetInt32("UserId");
}

<section class="section-shell chat-detail-shell">
    <div class="container">
        <div class="app-card chat-detail-card p-0 overflow-hidden">
            <div class="chat-detail-topbar">
                <div class="d-flex align-items-center gap-3">
                    <a href="@Url.Action("Index", "Chat")" class="chat-detail-back">
                        <i class="bi bi-arrow-left"></i>
                    </a>

                    <div class="chat-detail-user">
                        <div class="chat-detail-avatar">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <div class="chat-detail-name">@ViewBag.OtherUserName</div>
                            <div class="chat-detail-status">Đang mở cuộc trò chuyện</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="chat-detail-body" id="chatMessages">
                @if (Model == null || Model.Count == 0)
                {
                    <div class="chat-empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-chat-square-dots"></i>
                        </div>
                        <h5 class="fw-bold">Chưa có tin nhắn nào</h5>
                        <p class="mb-0">Hãy bắt đầu cuộc trò chuyện bằng tin nhắn đầu tiên.</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in Model)
                    {
                        var isCurrentUser = msg.SenderId == currentUserId;
                        <div class="chat-message-row @(isCurrentUser ? "mine" : "other")">
                            <div class="chat-message @(isCurrentUser ? "mine" : "other")">
                                <div class="chat-message-meta">
                                    <span class="sender-name">@(isCurrentUser ? "Bạn" : msg.SenderName)</span>
                                    <span class="message-time">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                                </div>
                                <div class="chat-message-text">@msg.Message</div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="chat-detail-footer">
                <div class="chat-input-wrap">
                    <input type="text"
                           id="messageInput"
                           class="chat-message-input"
                           placeholder="Nhập tin nhắn..." />
                    <button type="button" class="chat-send-btn" onclick="sendMessage()">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.0/signalr.min.js"></script>
    <script>
        const currentUserId = "@Context.Session.GetInt32("UserId")";
        const chatSessionId = @ViewBag.ChatSessionId;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (userId, message, timestamp) {
            const chatBox = document.getElementById("chatMessages");
            const isCurrentUser = userId == currentUserId;

            const msgHtml = `
                <div class="chat-message-row ${isCurrentUser ? "mine" : "other"}">
                    <div class="chat-message ${isCurrentUser ? "mine" : "other"} animate-slide-in">
                        <div class="chat-message-meta">
                            <span class="sender-name">${isCurrentUser ? "Bạn" : "Người khác"}</span>
                            <span class="message-time">${timestamp}</span>
                        </div>
                        <div class="chat-message-text">${message}</div>
                    </div>
                </div>`;

            const emptyState = chatBox.querySelector(".chat-empty-state");
            if (emptyState) emptyState.remove();

            chatBox.insertAdjacentHTML("beforeend", msgHtml);
            chatBox.scrollTop = chatBox.scrollHeight;
        });

        connection.on("ReceiveError", function (error) {
            console.error(error);
            alert("Lỗi: " + error);
        });

        connection.on("NotifyNewMessage", function (senderName, message, sessionId) {
            if (sessionId != chatSessionId) {
                showToast(`${senderName}: ${message}`);
            }
        });

        connection.start().then(() => {
            connection.invoke("JoinSession", chatSessionId).catch(err => console.error(err));
            const chatBox = document.getElementById("chatMessages");
            chatBox.scrollTop = chatBox.scrollHeight;
        }).catch(err => console.error(err));

        function sendMessage() {
            const input = document.getElementById("messageInput");
            const message = input.value.trim();

            if (message) {
                connection.invoke("SendMessage", currentUserId, message, chatSessionId)
                    .catch(err => console.error(err));
                input.value = "";
                input.focus();
            }
        }

        document.getElementById("messageInput").addEventListener("keypress", function (event) {
            if (event.key === "Enter") {
                sendMessage();
            }
        });

        setInterval(() => {
            fetch(window.location.href)
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, "text/html");
                    const newMessages = doc.querySelector("#chatMessages");
                    const currentMessages = document.querySelector("#chatMessages");

                    if (newMessages && currentMessages) {
                        currentMessages.innerHTML = newMessages.innerHTML;
                        currentMessages.scrollTop = currentMessages.scrollHeight;
                    }
                });
        }, 3000);
    </script>
}