@model List<ChatSessionViewModel>

@{
    ViewData["Title"] = "Tin nhắn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-shell">
    <div class="container">
        <div class="page-hero chat-index-hero mb-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-chat-dots"></i>
                        Kết nối và trao đổi
                    </span>
                    <h1 class="mb-3">Danh sách cuộc trò chuyện</h1>
                    <p class="mb-0">
                        Theo dõi các phiên trao đổi với chuyên gia hoặc người dùng khác trong hệ thống.
                        Mọi hội thoại sẽ được hiển thị tập trung để bạn dễ tìm và tiếp tục cuộc trò chuyện.
                    </p>
                </div>

                <div class="col-lg-4">
                    <div class="chat-index-side-note">
                        <h5>Tổng hội thoại</h5>
                        <p class="mb-0">@(Model?.Count ?? 0) cuộc trò chuyện</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card chat-index-card p-4 p-lg-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Hộp thư trò chuyện</h4>
                    <p class="section-subtitle mb-0">
                        Chọn một hội thoại để xem chi tiết và tiếp tục nhắn tin.
                    </p>
                </div>

                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </a>
            </div>

            @if (Model == null || Model.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-chat-square-text"></i>
                    </div>
                    <h5 class="fw-bold">Chưa có cuộc trò chuyện nào</h5>
                    <p class="mb-0">
                        Khi bạn bắt đầu nhắn tin với chuyên gia hoặc người dùng khác, danh sách hội thoại sẽ xuất hiện tại đây.
                    </p>
                </div>
            }
            else
            {
                <div class="chat-index-list-wrap">
                    @await Html.PartialAsync("_ChatList", Model)
                </div>
            }
        </div>
    </div>
</section>