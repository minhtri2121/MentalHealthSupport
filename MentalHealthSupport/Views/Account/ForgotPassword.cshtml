@model MentalHealthSupport.Models.ViewModel.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-shell">
    <div class="container">
        <div class="row g-4 align-items-center auth-wrapper">
            <div class="col-lg-6">
                <div class="auth-intro">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-key"></i>
                        Khôi phục tài khoản
                    </span>
                    <h1 class="auth-title mb-3">Quên mật khẩu?</h1>
                    <p class="auth-subtitle mb-4">
                        Đừng lo. Bạn có thể xác minh thông tin để tiếp tục đặt lại mật khẩu và truy cập lại tài khoản của mình.
                    </p>

                    <div class="auth-feature-list">
                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-envelope-check"></i>
                            </div>
                            <div>
                                <h6>Xác minh thông tin</h6>
                                <p class="mb-0">Nhập email đã đăng ký để hệ thống tìm đúng tài khoản của bạn.</p>
                            </div>
                        </div>

                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <div>
                                <h6>Bảo mật tài khoản</h6>
                                <p class="mb-0">Quy trình xác minh giúp đảm bảo chỉ chủ tài khoản mới có thể đặt lại mật khẩu.</p>
                            </div>
                        </div>

                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-arrow-repeat"></i>
                            </div>
                            <div>
                                <h6>Khôi phục nhanh</h6>
                                <p class="mb-0">Sau khi xác minh thành công, bạn có thể đặt mật khẩu mới ngay lập tức.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="app-card auth-card p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">Tìm tài khoản</h2>
                        <p class="section-subtitle mb-0">Nhập email để bắt đầu quá trình khôi phục</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string))
                    {
                        <div class="alert alert-danger rounded-4 mb-4">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(ViewBag.SuccessMessage as string))
                    {
                        <div class="alert alert-success rounded-4 mb-4">
                            @ViewBag.SuccessMessage
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 mb-4"></div>

                    <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">Email đã đăng ký</label>
                            <div class="auth-input-group">
                                <span class="auth-input-icon">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email"
                                       class="form-control auth-input"
                                       placeholder="example@email.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 auth-submit-btn">
                            <i class="bi bi-search me-2"></i>Tiếp tục
                        </button>
                    </form>

                    <div class="auth-footer text-center mt-4 pt-4">
                        <a asp-action="Login" asp-controller="Account" class="auth-text-link">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}