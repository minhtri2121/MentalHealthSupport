@model MentalHealthSupport.Models.ViewModel.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên Mật Khẩu";
}

<div class="bg-light min-vh-100 d-flex align-items-center justify-content-center">
    <div class="w-100 p-4" style="max-width: 28rem;">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Quên Mật Khẩu</h2>
            <p class="text-muted">Nhập email để bắt đầu khôi phục</p>
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @ViewData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="example@email.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Tiếp tục</button>
                </form>
            </div>
            <div class="card-footer bg-white text-center py-3">
                <a asp-action="Login" asp-controller="Account" class="text-primary text-decoration-none">Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}