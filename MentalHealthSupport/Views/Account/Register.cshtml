@model MentalHealthSupport.Models.ViewModel.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-shell">
    <div class="container">
        <div class="row g-4 align-items-center auth-wrapper">
            <div class="col-lg-6">
                <div class="auth-intro">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-person-plus"></i>
                        MentalHealthSupport
                    </span>
                    <h1 class="auth-title mb-3">Tạo tài khoản mới</h1>
                    <p class="auth-subtitle mb-4">
                        Đăng ký để bắt đầu hành trình chăm sóc sức khỏe tinh thần, đặt lịch với chuyên gia và sử dụng các công cụ hỗ trợ phù hợp với bạn.
                    </p>

                    <div class="auth-feature-list">
                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div>
                                <h6>Bảo mật thông tin</h6>
                                <p class="mb-0">Tài khoản và nội dung trao đổi được quản lý an toàn và riêng tư.</p>
                            </div>
                        </div>

                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-calendar-heart"></i>
                            </div>
                            <div>
                                <h6>Đặt lịch dễ dàng</h6>
                                <p class="mb-0">Nhanh chóng kết nối với chuyên gia phù hợp và theo dõi lịch hẹn của bạn.</p>
                            </div>
                        </div>

                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-chat-square-heart"></i>
                            </div>
                            <div>
                                <h6>Đồng hành lâu dài</h6>
                                <p class="mb-0">Lưu lại hành trình hỗ trợ để bạn dễ xem lại và tiếp tục khi cần.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="app-card auth-card p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">Đăng ký tài khoản</h2>
                        <p class="section-subtitle mb-0">Điền đầy đủ thông tin để bắt đầu</p>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 mb-4"></div>

                    <form asp-action="Register" asp-controller="Account" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Họ tên</label>
                            <div class="auth-input-group">
                                <span class="auth-input-icon">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input asp-for="FullName"
                                       class="form-control auth-input"
                                       placeholder="Nhập họ tên của bạn" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <div class="auth-input-group">
                                <span class="auth-input-icon">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email"
                                       class="form-control auth-input"
                                       placeholder="example@email.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Số điện thoại</label>
                            <div class="auth-input-group">
                                <span class="auth-input-icon">
                                    <i class="bi bi-telephone"></i>
                                </span>
                                <input asp-for="Phone"
                                       class="form-control auth-input"
                                       placeholder="Nhập số điện thoại" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PasswordHash" class="form-label">Mật khẩu</label>
                            <div class="auth-input-group">
                                <span class="auth-input-icon">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="PasswordHash"
                                       type="password"
                                       class="form-control auth-input auth-password-input"
                                       id="registerPassword"
                                       placeholder="••••••••" />
                                <button type="button" class="auth-toggle-password" id="toggleRegisterPassword" aria-label="Hiện hoặc ẩn mật khẩu">
                                    <i class="bi bi-eye" id="registerEyeIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                            <div class="auth-input-group">
                                <span class="auth-input-icon">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control auth-input auth-password-input"
                                       id="confirmRegisterPassword"
                                       placeholder="••••••••" />
                                <button type="button" class="auth-toggle-password" id="toggleConfirmRegisterPassword" aria-label="Hiện hoặc ẩn mật khẩu xác nhận">
                                    <i class="bi bi-eye" id="confirmRegisterEyeIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sex" class="form-label">Giới tính</label>
                            <select asp-for="Sex" class="form-select auth-input">
                                <option value="true">Nam</option>
                                <option value="false">Nữ</option>
                            </select>
                            <span asp-validation-for="Sex" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SecurityQuestion" class="form-label">Câu hỏi bảo mật</label>
                            <input asp-for="SecurityQuestion"
                                   class="form-control auth-input"
                                   placeholder="Ví dụ: Tên trường cấp 3 của bạn là gì?" />
                            <span asp-validation-for="SecurityQuestion" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SecurityAnswer" class="form-label">Câu trả lời bảo mật</label>
                            <input asp-for="SecurityAnswer"
                                   class="form-control auth-input"
                                   placeholder="Nhập câu trả lời bảo mật" />
                            <span asp-validation-for="SecurityAnswer" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 auth-submit-btn">
                            <i class="bi bi-person-check me-2"></i>Đăng ký
                        </button>
                    </form>

                    <div class="auth-footer text-center mt-4 pt-4">
                        <span class="section-subtitle">Đã có tài khoản?</span>
                        <a asp-action="Login" asp-controller="Account" class="auth-text-link ms-1">
                            Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setupToggle(buttonId, inputId, iconId) {
            document.getElementById(buttonId)?.addEventListener('click', function () {
                const input = document.getElementById(inputId);
                const icon = document.getElementById(iconId);

                if (!input || !icon) return;

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        }

        setupToggle('toggleRegisterPassword', 'registerPassword', 'registerEyeIcon');
        setupToggle('toggleConfirmRegisterPassword', 'confirmRegisterPassword', 'confirmRegisterEyeIcon');
    </script>
}