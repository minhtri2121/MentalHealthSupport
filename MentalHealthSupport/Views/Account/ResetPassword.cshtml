@model MentalHealthSupport.Models.ViewModel.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-shell">
    <div class="container">
        <div class="row g-4 align-items-center auth-wrapper">
            <div class="col-lg-6">
                <div class="auth-intro">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-key-fill"></i>
                        Đặt lại mật khẩu
                    </span>
                    <h1 class="auth-title mb-3">Tạo mật khẩu mới</h1>
                    <p class="auth-subtitle mb-4">
                        Sau khi xác minh thành công, bạn có thể đặt lại mật khẩu mới để truy cập lại tài khoản một cách an toàn.
                    </p>

                    <div class="auth-feature-list">
                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <div>
                                <h6>Bảo vệ tài khoản</h6>
                                <p class="mb-0">Mật khẩu mới giúp tăng cường bảo mật và ngăn truy cập trái phép.</p>
                            </div>
                        </div>

                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-lock"></i>
                            </div>
                            <div>
                                <h6>Mật khẩu mạnh hơn</h6>
                                <p class="mb-0">Hãy chọn mật khẩu đủ dài, dễ nhớ với bạn nhưng khó đoán với người khác.</p>
                            </div>
                        </div>

                        <div class="auth-feature-item">
                            <div class="auth-feature-icon">
                                <i class="bi bi-check2-circle"></i>
                            </div>
                            <div>
                                <h6>Khôi phục nhanh</h6>
                                <p class="mb-0">Sau khi lưu, bạn có thể đăng nhập lại ngay bằng mật khẩu mới.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="app-card auth-card p-4 p-lg-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">Đặt lại mật khẩu</h2>
                        <p class="section-subtitle mb-0">Nhập mật khẩu mới cho tài khoản của bạn</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ViewData["ErrorMessage"]?.ToString()))
                    {
                        <div class="alert alert-danger rounded-4 mb-4">
                            @ViewData["ErrorMessage"]
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(ViewData["SuccessMessage"]?.ToString()))
                    {
                        <div class="alert alert-success rounded-4 mb-4">
                            @ViewData["SuccessMessage"]
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 mb-4"></div>

                    <form asp-action="ResetPassword" asp-controller="Account" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Email" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                            <div class="auth-input-group">
                                <span class="auth-input-icon">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="NewPassword"
                                       type="password"
                                       class="form-control auth-input auth-password-input"
                                       id="resetPassword"
                                       placeholder="••••••••" />
                                <button type="button" class="auth-toggle-password" id="toggleResetPassword" aria-label="Hiện hoặc ẩn mật khẩu mới">
                                    <i class="bi bi-eye" id="resetEyeIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                            <div class="auth-input-group">
                                <span class="auth-input-icon">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control auth-input auth-password-input"
                                       id="confirmResetPassword"
                                       placeholder="••••••••" />
                                <button type="button" class="auth-toggle-password" id="toggleConfirmResetPassword" aria-label="Hiện hoặc ẩn xác nhận mật khẩu">
                                    <i class="bi bi-eye" id="confirmResetEyeIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 auth-submit-btn">
                            <i class="bi bi-arrow-repeat me-2"></i>Cập nhật mật khẩu
                        </button>
                    </form>

                    <div class="auth-footer text-center mt-4 pt-4">
                        <a asp-action="Login" asp-controller="Account" class="auth-text-link">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setupToggle(buttonId, inputId, iconId) {
            document.getElementById(buttonId)?.addEventListener('click', function () {
                const input = document.getElementById(inputId);
                const icon = document.getElementById(iconId);

                if (!input || !icon) return;

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        }

        setupToggle('toggleResetPassword', 'resetPassword', 'resetEyeIcon');
        setupToggle('toggleConfirmResetPassword', 'confirmResetPassword', 'confirmResetEyeIcon');
    </script>
}