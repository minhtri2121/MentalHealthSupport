@model List<ChatSessionViewModel>

@if (Model == null || Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">
            <i class="bi bi-chat-square-text"></i>
        </div>
        <h5 class="fw-bold">Chưa có cuộc trò chuyện nào</h5>
        <p class="mb-0">Danh sách hội thoại sẽ xuất hiện tại đây khi bạn bắt đầu nhắn tin.</p>
    </div>
}
else
{
    <div class="chat-session-list">
        @foreach (var session in Model)
        {
            <a asp-controller="Chat"
               asp-action="Detail"
               asp-route-id="@session.ChatSessionId"
               class="chat-session-item text-decoration-none">
                <div class="chat-session-avatar">
                    <i class="bi bi-person"></i>
                </div>

                <div class="chat-session-main">
                    <div class="chat-session-top">
                        <h5 class="chat-session-name mb-0">
                            @session.OtherUserName
                        </h5>

                        @if (session.UnreadCount > 0)
                        {
                            <span class="chat-session-badge">
                                @session.UnreadCount
                            </span>
                        }
                    </div>

                    <div class="chat-session-bottom">
                        <p class="chat-session-preview mb-0">
                            Nhấn để mở cuộc trò chuyện
                        </p>
                    </div>
                </div>
            </a>
        }
    </div>
}