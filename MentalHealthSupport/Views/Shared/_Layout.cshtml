@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MentalHealthSupport</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
</head>
<body class="app-shell">
    @functions {
        bool IsActive(string controller, string? action = null)
        {
            var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
            var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
            return currentController == controller && (action == null || currentAction == action);
        }
    }

    <div id="preloader" class="app-preloader">
        <div class="loader-content text-center">
            <div class="loader-heart-wrap">
                <i class="bi bi-heart-pulse-fill loader-heart"></i>
            </div>
            <p class="loader-text mb-0">Đang tải trải nghiệm tốt hơn...</p>
        </div>
    </div>

    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-light fixed-top app-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="@Url.Content("~/images/Logo.png")" alt="Logo" class="brand-logo" />
                    <span class="brand-text">MentalHealthSupport</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto app-nav-list">
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Home", "Index") ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("Consultants") ? "active" : "")"
                               asp-controller="Consultants" asp-action="Index">Chuyên gia</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("News") ? "active" : "")"
                               asp-controller="News" asp-action="Index">Tin tức</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(IsActive("About") ? "active" : "")"
                               asp-controller="About" asp-action="Index">Về chúng tôi</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (Context.Session.GetInt32("UserId") == null)
                        {
                            <li class="nav-item">
                                <a class="btn btn-app-outline" asp-controller="Account" asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-menu-trigger" href="#"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar"><i class="bi bi-person"></i></span>
                                    <span>@Context.Session.GetString("FullName")</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 app-dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Manage">
                                            <i class="bi bi-person-circle me-2"></i>Hồ sơ
                                        </a>
                                    </li>

                                    @if (Context.Session.GetString("UserRole") == "Admin")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-grid me-2"></i>Quản lý
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Chatbot" asp-action="History">
                                                <i class="bi bi-clock-history me-2"></i>Lịch sử chatbot
                                            </a>
                                        </li>
                                    }

                                    @if (Context.Session.GetString("UserRole") == "Consultant")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Appointments" asp-action="ConsultantAppointments">
                                                <i class="bi bi-calendar2-check me-2"></i>Lịch tư vấn
                                            </a>
                                        </li>
                                    }

                                    @if (Context.Session.GetString("UserRole") == "User")
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Appointments" asp-action="MyAppointments">
                                                <i class="bi bi-calendar-week me-2"></i>Lịch hẹn của tôi
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    @if (Context.Session.GetInt32("UserId") != null)
    {
        <button class="chat-icon" id="openChatModal" type="button" title="Mở chat">
            <i class="fas fa-comments"></i>
            <span id="chat-icon-badge" class="chat-badge">0</span>
        </button>
    }

    <footer class="app-footer">
        <div class="container">
            <div class="row g-4 footer-top">
                <div class="col-lg-4">
                    <div class="footer-brand d-flex align-items-center gap-2 mb-3">
                        <img src="@Url.Content("~/images/Logo.png")" alt="Logo" class="footer-logo" />
                        <span class="brand-text text-white">MentalHealthSupport</span>
                    </div>
                    <p class="footer-desc">
                        Không chỉ kết nối với chuyên gia, chúng tôi còn đồng hành để người dùng cảm thấy an toàn,
                        được lắng nghe và được hỗ trợ đúng lúc.
                    </p>
                    <div class="social-list d-flex gap-3 mt-3">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-youtube"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>

                <div class="col-lg-4">
                    <h5 class="footer-title">Điều hướng</h5>
                    <ul class="footer-links list-unstyled">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-controller="Consultants" asp-action="Index">Chuyên gia</a></li>
                        <li><a asp-controller="News" asp-action="Index">Tin tức</a></li>
                        <li><a asp-controller="About" asp-action="Index">Về chúng tôi</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    </ul>
                </div>

                <div class="col-lg-4">
                    <h5 class="footer-title">Liên hệ</h5>
                    <ul class="footer-contact list-unstyled">
                        <li><i class="bi bi-geo-alt"></i><span>123 Nguyễn Văn Linh, TP. Hồ Chí Minh</span></li>
                        <li><i class="bi bi-telephone"></i><a href="tel:+842812345678">+84 28 1234 5678</a></li>
                        <li><i class="bi bi-envelope"></i><a href="mailto:info@tamlyvn.com">info@tamlyvn.com</a></li>
                        <li><i class="bi bi-clock"></i><span>Hỗ trợ trực tuyến 24/7</span></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <p class="mb-0">© 2025 MentalHealthSupport. Tất cả quyền được bảo lưu.</p>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>
                    <a asp-controller="Home" asp-action="Terms">Điều khoản dịch vụ</a>
                </div>
            </div>
        </div>
    </footer>

    <div id="chatbot-toggle" class="chatbot-toggle">
        <i class="fas fa-robot"></i>
    </div>

    <div id="chatbot-widget" class="chatbot-widget d-none">
        <div class="chatbot-header">
            <div>
                <strong>Trợ lý MentalHealthSupport</strong>
                <div class="chatbot-subtitle">Hỗ trợ thông tin nhanh</div>
            </div>
            <button type="button" id="chatbot-close" class="chatbot-close">&times;</button>
        </div>

        <div id="chatbot-quick-replies" class="chatbot-quick-replies">
            <button type="button" class="chatbot-quick-btn" data-message="Tìm chuyên gia">Tìm chuyên gia</button>
            <button type="button" class="chatbot-quick-btn" data-message="Bài viết mới">Bài viết mới</button>
            <button type="button" class="chatbot-quick-btn" data-message="Lịch hẹn của tôi">Lịch hẹn của tôi</button>
            <button type="button" class="chatbot-quick-btn" data-message="Cách đặt lịch">Cách đặt lịch</button>
        </div>

        <div id="chatbot-messages" class="chatbot-messages">
            <div class="chatbot-bot-wrapper">
                <div class="chatbot-bot-message">
                    Xin chào, mình là chatbot hỗ trợ. Bạn có thể hỏi về chuyên gia, đặt lịch, lịch hẹn hoặc bài viết.
                </div>
            </div>
        </div>

        <div class="chatbot-input-area">
            <input type="text" id="chatbot-input" class="chatbot-input" placeholder="Nhập câu hỏi của bạn..." />
            <button type="button" id="chatbot-send" class="chatbot-send">Gửi</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        window.currentChatbotUserId = '@(Context.Session.GetInt32("UserId")?.ToString() ?? "guest")';

        $(window).on('load', function () {
            $('#preloader').fadeOut(300);
        });

        $(window).on('scroll', function () {
            $('.app-navbar').toggleClass('navbar-scrolled', $(window).scrollTop() > 20);
        });

        function showToast(text) {
            const toast = document.createElement("div");
            toast.className = "toast-message";
            toast.innerText = text.length > 50 ? text.substring(0, 47) + "..." : text;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3200);
        }
    </script>

    @if (Context.Session.GetInt32("UserId") != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const chatIcon = document.getElementById("openChatModal");
                const badge = document.getElementById("chat-icon-badge");

                if (chatIcon) {
                    chatIcon.addEventListener("click", function () {
                        if (badge) {
                            badge.innerText = "0";
                            badge.style.display = "none";
                        }
                        window.location.href = "/Chat/Index";
                    });
                }

                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/chatHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("NotifyNewMessage", function (senderName, message) {
                    showToast(`${senderName}: ${message}`);

                    if (badge) {
                        let current = parseInt(badge.innerText || "0");
                        if (isNaN(current)) current = 0;
                        current++;
                        badge.innerText = current.toString();
                        badge.style.display = "inline-flex";
                    }
                });

                connection.start().catch(err => console.error(err.toString()));
            });
        </script>
    }
</body>
</html>