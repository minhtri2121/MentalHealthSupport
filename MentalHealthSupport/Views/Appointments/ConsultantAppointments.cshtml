@model List<MentalHealthSupport.Models.ViewModel.ConsultantAppointmentViewModel>

@{
    ViewData["Title"] = "Lịch hẹn tư vấn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Lịch hẹn của chuyên gia</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Hiện chưa có lịch hẹn nào.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Người dùng</th>
                        <th>Thời gian hẹn</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th>Ngày tạo</th>
                        <th style="width: 260px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.UserName</td>
                            <td>@item.AppointmentTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                }
                                else if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-primary">Đã xác nhận</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Đã hoàn thành</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>@item.Note</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (item.Status == "Pending")
                                    {
                                        <form asp-action="Confirm" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.AppointmentId" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                Xác nhận
                                            </button>
                                        </form>

                                        <form asp-action="Reject" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.AppointmentId" />
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                Từ chối
                                            </button>
                                        </form>
                                    }

                                    @if (item.Status == "Confirmed")
                                    {
                                        <form asp-action="Complete" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.AppointmentId" />
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                Hoàn thành
                                            </button>
                                        </form>

                                        <form asp-action="Reject" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.AppointmentId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                Hủy lịch
                                            </button>
                                        </form>
                                    }

                                    @if (item.Status == "Completed" || item.Status == "Cancelled")
                                    {
                                        <span class="text-muted small">Không còn thao tác</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>