@model MentalHealthSupport.Models.ViewModel.CreateAppointmentViewModel
@{
    ViewData["Title"] = "Đặt lịch tư vấn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-shell">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="page-hero appointment-create-hero mb-4">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-8">
                            <span class="badge-soft primary mb-3">
                                <i class="bi bi-calendar2-plus"></i>
                                Đặt lịch tư vấn
                            </span>
                            <h1 class="mb-3">Tạo lịch hẹn với chuyên gia</h1>
                            <p class="mb-0">
                                Chọn thời gian phù hợp và thêm ghi chú ngắn để chuyên gia nắm rõ nhu cầu hỗ trợ của bạn.
                            </p>
                        </div>
                        <div class="col-lg-4">
                            <div class="appointment-create-side-note">
                                <h5>Lưu ý</h5>
                                <p class="mb-0">
                                    Nên chọn thời gian hợp lý và mô tả ngắn vấn đề để quá trình xác nhận diễn ra nhanh hơn.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="app-card appointment-create-card p-4 p-lg-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-4 mb-4" asp-validation-summary="All"></div>
                    }

                    <div class="row g-4">
                        <div class="col-lg-7">
                            <form asp-action="Create" method="post" class="appointment-form">
                                <input type="hidden" asp-for="ConsultantId" />

                                <div class="form-section-block mb-4">
                                    <div class="form-section-header mb-3">
                                        <div class="form-section-icon">
                                            <i class="bi bi-clock-history"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1">Thông tin lịch hẹn</h5>
                                            <p class="section-subtitle mb-0">
                                                Điền thời gian bạn muốn bắt đầu buổi tư vấn.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="AppointmentTime" class="form-label">Thời gian tư vấn</label>
                                        <input asp-for="AppointmentTime" type="datetime-local" class="form-control" />
                                        <span asp-validation-for="AppointmentTime" class="text-danger small"></span>
                                        <div class="form-hint mt-2">
                                            Nên chọn trước vài giờ để chuyên gia dễ xác nhận lịch hẹn.
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section-block mb-4">
                                    <div class="form-section-header mb-3">
                                        <div class="form-section-icon">
                                            <i class="bi bi-journal-text"></i>
                                        </div>
                                        <div>
                                            <h5 class="fw-bold mb-1">Ghi chú hỗ trợ</h5>
                                            <p class="section-subtitle mb-0">
                                                Mô tả ngắn vấn đề hoặc nhu cầu bạn muốn trao đổi.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="mb-0">
                                        <label asp-for="Note" class="form-label">Ghi chú</label>
                                        <textarea asp-for="Note"
                                                  class="form-control appointment-note-input"
                                                  rows="6"
                                                  placeholder="Ví dụ: Tôi đang cảm thấy căng thẳng kéo dài, khó ngủ và muốn được tư vấn hướng cải thiện."></textarea>
                                        <span asp-validation-for="Note" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-3 mt-4">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="bi bi-calendar-check me-2"></i>Xác nhận đặt lịch
                                    </button>

                                    <a asp-controller="Consultants" asp-action="Index" class="btn btn-secondary">
                                        <i class="bi bi-arrow-left me-2"></i>Quay lại
                                    </a>
                                </div>
                            </form>
                        </div>

                        <div class="col-lg-5">
                            <div class="appointment-help-panel h-100">
                                <div class="appointment-help-top mb-4">
                                    <span class="badge-soft primary mb-3">
                                        <i class="bi bi-lightbulb"></i>
                                        Hướng dẫn nhanh
                                    </span>
                                    <h4 class="fw-bold mb-2">Một lịch hẹn hiệu quả nên có gì?</h4>
                                    <p class="section-subtitle mb-0">
                                        Chỉ cần vài thông tin cơ bản là chuyên gia đã có thể hiểu tốt hơn nhu cầu của bạn.
                                    </p>
                                </div>

                                <div class="appointment-help-list">
                                    <div class="appointment-help-item">
                                        <div class="appointment-help-icon">
                                            <i class="bi bi-1-circle-fill"></i>
                                        </div>
                                        <div>
                                            <h6>Chọn thời gian phù hợp</h6>
                                            <p class="mb-0">Ưu tiên mốc thời gian bạn có thể tham gia đầy đủ và thoải mái.</p>
                                        </div>
                                    </div>

                                    <div class="appointment-help-item">
                                        <div class="appointment-help-icon">
                                            <i class="bi bi-2-circle-fill"></i>
                                        </div>
                                        <div>
                                            <h6>Viết ghi chú ngắn gọn</h6>
                                            <p class="mb-0">Nêu vấn đề chính để chuyên gia chuẩn bị định hướng tư vấn phù hợp hơn.</p>
                                        </div>
                                    </div>

                                    <div class="appointment-help-item">
                                        <div class="appointment-help-icon">
                                            <i class="bi bi-3-circle-fill"></i>
                                        </div>
                                        <div>
                                            <h6>Theo dõi trạng thái lịch hẹn</h6>
                                            <p class="mb-0">Sau khi gửi, bạn có thể xem xác nhận trong khu vực lịch hẹn của mình.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="appointment-tip-box mt-4">
                                    <h6 class="fw-bold mb-2">
                                        <i class="bi bi-shield-check me-2"></i>Bảo mật thông tin
                                    </h6>
                                    <p class="mb-0">
                                        Chỉ nên nhập nội dung vừa đủ để mô tả nhu cầu, tránh ghi quá nhiều thông tin riêng tư không cần thiết.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}