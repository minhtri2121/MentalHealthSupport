@model List<MentalHealthSupport.Models.ViewModel.ChatbotHistoryViewModel>

@{
    ViewData["Title"] = "Lịch sử chatbot";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-shell">
    <div class="container">
        <div class="page-hero chatbot-history-hero mb-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-clock-history"></i>
                        Nhật ký hỗ trợ
                    </span>
                    <h1 class="mb-3">Lịch sử trò chuyện với chatbot</h1>
                    <p class="mb-0">
                        Xem lại các câu hỏi và phản hồi trước đó để dễ theo dõi quá trình hỗ trợ và tìm lại thông tin cần thiết.
                    </p>
                </div>

                <div class="col-lg-4">
                    <div class="chatbot-history-side-note">
                        <h5>Tổng hội thoại</h5>
                        <p class="mb-0">@(Model?.Count ?? 0) mục lịch sử</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2 mb-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-2"></i>Quay lại
            </a>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-chat-dots"></i>
                </div>
                <h5 class="fw-bold">Chưa có lịch sử chatbot</h5>
                <p class="mb-0">
                    Các đoạn hội thoại với chatbot sẽ xuất hiện tại đây sau khi bạn sử dụng tính năng hỗ trợ.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model.OrderByDescending(x => x.CreatedAt))
                {
                    <div class="col-12">
                        <div class="app-card chatbot-history-card p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="chatbot-history-icon">
                                        <i class="bi bi-robot"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-1">
                                            @(string.IsNullOrWhiteSpace(item.UserName) ? "Người dùng" : item.UserName)
                                        </h5>
                                        <div class="section-subtitle">
                                            @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>

                                <span class="badge-soft primary">
                                    <i class="bi bi-chat-square-text"></i>
                                    Lịch sử
                                </span>
                            </div>

                            <div class="chatbot-history-content">
                                <div class="chatbot-history-block user mb-3">
                                    <div class="chatbot-history-label">
                                        <i class="bi bi-person-circle me-2"></i>Câu hỏi
                                    </div>
                                    <div class="chatbot-history-bubble user">
                                        @(string.IsNullOrWhiteSpace(item.UserMessage) ? "Không có nội dung câu hỏi." : item.UserMessage)
                                    </div>
                                </div>

                                <div class="chatbot-history-block bot">
                                    <div class="chatbot-history-label">
                                        <i class="bi bi-robot me-2"></i>Phản hồi
                                    </div>
                                    <div class="chatbot-history-bubble bot">
                                        @(string.IsNullOrWhiteSpace(item.BotReply) ? "Không có phản hồi." : item.BotReply)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>