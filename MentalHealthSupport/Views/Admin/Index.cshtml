@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
<!-- Custom Admin CSS -->
<link rel="stylesheet" href="~/css/admin.css" />

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-center dashboard-title">📊 Bảng Điều Khiển Quản Lý</h1>
        <a asp-controller="Home" asp-action="Index" class="btn btn-back"><i class="fas fa-arrow-left me-2"></i>Trở Về</a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card card-admin text-center p-4 shadow">
                <i class="fas fa-newspaper mb-3"></i>
                <h5>Tin Tức</h5>
                <p>Quản lý bài viết tin tức.</p>
                <a asp-action="NewsList" class="btn btn-primary">Xem</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-admin text-center p-4 shadow">
                <i class="fas fa-users mb-3"></i>
                <h5>Người Dùng</h5>
                <p>Quản lý tài khoản người dùng.</p>
                <a asp-action="UserList" class="btn btn-primary">Xem</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-admin text-center p-4 shadow">
                <i class="fas fa-user-tie mb-3"></i>
                <h5>Chuyên Gia</h5>
                <p>Quản lý hồ sơ chuyên gia.</p>
                <a asp-action="ConsultantList" class="btn btn-primary">Xem</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-admin text-center p-4 shadow">
                <i class="fas fa-lock mb-3"></i>
                <h5>Điều khoản dịch vụ</h5>
                <p>Quản lý Điều khoản dịch vụ và Chính sách bảo mật.</p>
                <a asp-action="PolicyList" class="btn btn-primary">Xem</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-admin text-center p-4 shadow">
                <i class="fas fa-info-circle mb-3"></i>
                <h5>Quản lý thông tin về chúng tôi</h5>
                <p>Quản lý Điều khoản dịch vụ và Chính sách bảo mật.</p>
                <a asp-action="EditAboutUs" class="btn btn-primary">Xem</a>
            </div>
        </div>
    </div>
</div>