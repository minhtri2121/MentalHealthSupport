@model IEnumerable<MentalHealthSupport.Models.ConsultantProfile>

@{
    ViewData["Title"] = "Quản lý chuyên gia";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string GetAvatarPath(string? avatarUrl)
    {
        if (string.IsNullOrWhiteSpace(avatarUrl))
            return Url.Content("~/images/default-avatar.png");

        if (avatarUrl.StartsWith("/"))
            return avatarUrl;

        if (avatarUrl.StartsWith("http://") || avatarUrl.StartsWith("https://"))
            return avatarUrl;

        if (avatarUrl.StartsWith("images/"))
            return Url.Content("~/" + avatarUrl);

        return Url.Content("~/images/" + avatarUrl);
    }
}

<section class="admin-consultant-list-page">
    <div class="admin-card mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-person-badge"></i>
                    Quản lý hồ sơ chuyên gia
                </span>
                <h2 class="fw-bold mb-3">Danh sách chuyên gia</h2>
                <p class="admin-section-subtitle mb-0">
                    Theo dõi, chỉnh sửa và quản lý hồ sơ chuyên gia tư vấn trong hệ thống MentalHealthSupport.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="admin-dashboard-highlight h-100">
                    <div class="admin-dashboard-highlight-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Thêm chuyên gia mới</h5>
                    <p class="mb-3">
                        Tạo nhanh hồ sơ chuyên gia để bổ sung đội ngũ hỗ trợ trên hệ thống.
                    </p>
                    <a asp-controller="Admin" asp-action="CreateConsultant" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Thêm chuyên gia
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card">
        <div class="admin-toolbar">
            <div>
                <h4 class="admin-section-title mb-1">Toàn bộ chuyên gia</h4>
                <p class="admin-section-subtitle">
                    Tổng số: <strong>@(Model?.Count() ?? 0)</strong> hồ sơ chuyên gia
                </p>
            </div>

            <a asp-controller="Admin" asp-action="CreateConsultant" class="btn btn-primary">
                <i class="bi bi-person-plus me-2"></i>Thêm mới
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="admin-empty-state">
                <i class="bi bi-person-badge"></i>
                <h5 class="fw-bold">Chưa có chuyên gia nào</h5>
                <p class="mb-3">Hãy thêm hồ sơ chuyên gia đầu tiên để bắt đầu quản lý đội ngũ tư vấn.</p>
                <a asp-controller="Admin" asp-action="CreateConsultant" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Tạo chuyên gia
                </a>
            </div>
        }
        else
        {
            <div class="app-table-shell admin-table-shell desktop-consultant-table">
                <div class="table-responsive">
                    <table class="table table-modern align-middle admin-consultant-table">
                        <thead>
                            <tr>
                                <th>Chuyên gia</th>
                                <th>Chuyên môn</th>
                                <th>Kinh nghiệm</th>
                                <th>Trạng thái</th>
                                <th>Chứng chỉ</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var consultant in Model)
                            {
                                var approvalClass = consultant.ApprovalStatus == "Approved"
                                    ? "success"
                                    : consultant.ApprovalStatus == "Pending"
                                        ? "warning"
                                        : "danger";

                                var approvalText = consultant.ApprovalStatus == "Approved"
                                    ? "Đã duyệt"
                                    : consultant.ApprovalStatus == "Pending"
                                        ? "Chờ duyệt"
                                        : consultant.ApprovalStatus == "Rejected"
                                            ? "Từ chối"
                                            : string.IsNullOrWhiteSpace(consultant.ApprovalStatus)
                                                ? "Chưa cập nhật"
                                                : consultant.ApprovalStatus;

                                <tr>
                                    <td>
                                        <div class="admin-user-cell">
                                            <img src="@GetAvatarPath(consultant.AvatarUrl)"
                                                 alt="@consultant.FullName"
                                                 class="admin-consultant-avatar" />
                                            <div>
                                                <div class="fw-bold">
                                                    @(string.IsNullOrWhiteSpace(consultant.FullName) ? "Chưa có tên" : consultant.FullName)
                                                </div>
                                                <div class="section-subtitle small">ID: @consultant.ConsultantId</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-email-cell">
                                            @(string.IsNullOrWhiteSpace(consultant.Specialty) ? "Chưa cập nhật" : consultant.Specialty)
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-date-cell">
                                            @consultant.ExperienceYears năm
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge-soft @approvalClass">
                                            @approvalText
                                        </span>
                                    </td>

                                    <td>
                                        <div class="admin-phone-cell">
                                            @(string.IsNullOrWhiteSpace(consultant.CertificateUrl) ? "Chưa cập nhật" : "Đã có chứng chỉ")
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-controller="Admin"
                                               asp-action="EditConsultant"
                                               asp-route-id="@consultant.ConsultantId"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square me-1"></i>Sửa
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="DeleteConsultant"
                                                  asp-route-id="@consultant.ConsultantId"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa chuyên gia này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash me-1"></i>Xóa
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="admin-consultant-mobile-list d-md-none mt-4">
                @foreach (var consultant in Model)
                {
                    var approvalClass = consultant.ApprovalStatus == "Approved"
                        ? "success"
                        : consultant.ApprovalStatus == "Pending"
                            ? "warning"
                            : "danger";

                    var approvalText = consultant.ApprovalStatus == "Approved"
                        ? "Đã duyệt"
                        : consultant.ApprovalStatus == "Pending"
                            ? "Chờ duyệt"
                            : consultant.ApprovalStatus == "Rejected"
                                ? "Từ chối"
                                : string.IsNullOrWhiteSpace(consultant.ApprovalStatus)
                                    ? "Chưa cập nhật"
                                    : consultant.ApprovalStatus;

                    <div class="admin-mobile-card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@GetAvatarPath(consultant.AvatarUrl)"
                                     alt="@consultant.FullName"
                                     class="admin-consultant-avatar" />
                                <div>
                                    <h6 class="fw-bold mb-1">
                                        @(string.IsNullOrWhiteSpace(consultant.FullName) ? "Chưa có tên" : consultant.FullName)
                                    </h6>
                                    <div class="section-subtitle small">
                                        @(string.IsNullOrWhiteSpace(consultant.Specialty) ? "Chưa cập nhật chuyên môn" : consultant.Specialty)
                                    </div>
                                </div>
                            </div>

                            <span class="badge-soft @approvalClass">@approvalText</span>
                        </div>

                        <div class="admin-mobile-info-grid mb-3">
                            <div>
                                <div class="admin-mobile-label">Kinh nghiệm</div>
                                <div class="admin-mobile-value">@consultant.ExperienceYears năm</div>
                            </div>

                            <div>
                                <div class="admin-mobile-label">Chứng chỉ</div>
                                <div class="admin-mobile-value">
                                    @(string.IsNullOrWhiteSpace(consultant.CertificateUrl) ? "Chưa cập nhật" : "Đã có chứng chỉ")
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Admin"
                               asp-action="EditConsultant"
                               asp-route-id="@consultant.ConsultantId"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </a>

                            <form asp-controller="Admin"
                                  asp-action="DeleteConsultant"
                                  asp-route-id="@consultant.ConsultantId"
                                  method="post"
                                  class="m-0"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa chuyên gia này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i>Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>