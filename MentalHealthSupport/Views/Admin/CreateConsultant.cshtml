@model MentalHealthSupport.ViewModels.ConsultantCreate

@{
    ViewData["Title"] = "Thêm chuyên gia";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-create-consultant-page">
    <div class="admin-card mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-person-plus"></i>
                    Tạo hồ sơ chuyên gia mới
                </span>
                <h2 class="fw-bold mb-3">Thêm chuyên gia tư vấn</h2>
                <p class="admin-section-subtitle mb-0">
                    Điền đầy đủ thông tin tài khoản và hồ sơ chuyên môn để tạo mới chuyên gia trong hệ thống.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="admin-dashboard-highlight h-100">
                    <div class="admin-dashboard-highlight-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Lưu ý</h5>
                    <p class="mb-0">
                        Hãy nhập thông tin chính xác để hồ sơ chuyên gia được hiển thị đầy đủ và đồng bộ trên website.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-form-card">
        <form asp-action="CreateConsultant" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 mb-4"></div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="form-section-block mb-4">
                        <div class="form-section-header mb-3">
                            <div class="form-section-icon">
                                <i class="bi bi-person-vcard"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Thông tin tài khoản</h5>
                                <p class="section-subtitle mb-0">Thông tin cơ bản dùng để đăng nhập và nhận diện chuyên gia.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label">Họ tên</label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">Mật khẩu</label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Role" class="form-label">Vai trò</label>
                                <input asp-for="Role" class="form-control" readonly />
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CreatedAt" class="form-label">Ngày tạo</label>
                                <input asp-for="CreatedAt" type="datetime-local" class="form-control" />
                                <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Sex" class="form-label">Giới tính</label>
                                <select asp-for="Sex" class="form-select">
                                    <option value="true">Nam</option>
                                    <option value="false">Nữ</option>
                                </select>
                                <span asp-validation-for="Sex" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mt-3">
                                    <input asp-for="IsVerified" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsVerified" class="form-check-label">Đánh dấu đã xác minh</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section-block mb-4">
                        <div class="form-section-header mb-3">
                            <div class="form-section-icon">
                                <i class="bi bi-award"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Thông tin chuyên môn</h5>
                                <p class="section-subtitle mb-0">Các thông tin hiển thị trong hồ sơ chuyên gia ngoài website.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Specialty" class="form-label">Chuyên ngành</label>
                                <input asp-for="Specialty" class="form-control" />
                                <span asp-validation-for="Specialty" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ExperienceYears" class="form-label">Số năm kinh nghiệm</label>
                                <input asp-for="ExperienceYears" type="number" class="form-control" min="0" />
                                <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ApprovalStatus" class="form-label">Trạng thái duyệt</label>
                                <select asp-for="ApprovalStatus" class="form-select">
                                    <option value="Pending">Chờ duyệt</option>
                                    <option value="Approved">Đã duyệt</option>
                                    <option value="Rejected">Từ chối</option>
                                </select>
                                <span asp-validation-for="ApprovalStatus" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CertificateUrl" class="form-label">Chứng chỉ</label>
                                <input asp-for="CertificateUrl" class="form-control" placeholder="Nhập tên file hoặc đường dẫn chứng chỉ" />
                                <span asp-validation-for="CertificateUrl" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Mô tả</label>
                                <textarea asp-for="Description" class="form-control appointment-note-input" rows="6" placeholder="Giới thiệu ngắn về chuyên gia, định hướng hỗ trợ, kinh nghiệm nổi bật..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section-block">
                        <div class="form-section-header mb-3">
                            <div class="form-section-icon">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Bảo mật tài khoản</h5>
                                <p class="section-subtitle mb-0">Thông tin dùng cho khôi phục hoặc xác minh tài khoản khi cần.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="SecurityQuestion" class="form-label">Câu hỏi bảo mật</label>
                                <input asp-for="SecurityQuestion" class="form-control" />
                                <span asp-validation-for="SecurityQuestion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SecurityAnswer" class="form-label">Câu trả lời bảo mật</label>
                                <input asp-for="SecurityAnswer" class="form-control" />
                                <span asp-validation-for="SecurityAnswer" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="appointment-help-panel h-100 admin-side-panel">
                        <div class="mb-4">
                            <span class="badge-soft primary mb-3">
                                <i class="bi bi-image"></i>
                                Ảnh đại diện
                            </span>

                            <label asp-for="AvatarFile" class="form-label">Chọn ảnh avatar</label>
                            <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" id="avatarFileInput" />
                            <span asp-validation-for="AvatarFile" class="text-danger small"></span>

                            <div class="mt-3">
                                <img id="avatarPreview"
                                     src="~/images/default-avatar.png"
                                     alt="Preview avatar"
                                     class="preview-image" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AvatarUrl" class="form-label">Tên file avatar</label>
                            <input asp-for="AvatarUrl" class="form-control" placeholder="Tự động hoặc nhập thủ công" />
                            <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                        </div>

                        <div class="appointment-tip-box">
                            <h6 class="fw-bold mb-2">
                                <i class="bi bi-info-circle me-2"></i>Gợi ý nhập liệu
                            </h6>
                            <p class="mb-2">- Email nên là email chưa tồn tại trong hệ thống.</p>
                            <p class="mb-2">- Chuyên ngành nên ngắn gọn, rõ ràng.</p>
                            <p class="mb-2">- Mô tả nên viết dễ hiểu, chuyên nghiệp.</p>
                            <p class="mb-0">- Ảnh avatar nên dùng ảnh vuông, rõ mặt, nền sạch.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>Tạo chuyên gia
                </button>

                <a asp-controller="Admin" asp-action="ConsultantList" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("avatarFileInput")?.addEventListener("change", function (event) {
            const file = event.target.files && event.target.files[0];
            const preview = document.getElementById("avatarPreview");

            if (!file || !preview) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
            };
            reader.readAsDataURL(file);
        });
    </script>
}