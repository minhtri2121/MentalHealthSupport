@model MentalHealthSupport.Models.User

@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-edit-user-page">
    <div class="admin-card mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-pencil-square"></i>
                    Cập nhật tài khoản người dùng
                </span>
                <h2 class="fw-bold mb-3">Chỉnh sửa người dùng</h2>
                <p class="admin-section-subtitle mb-0">
                    Cập nhật thông tin tài khoản, vai trò và bảo mật của người dùng trong hệ thống MentalHealthSupport.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="admin-dashboard-highlight h-100">
                    <div class="admin-dashboard-highlight-icon">
                        <i class="bi bi-info-circle"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Lưu ý</h5>
                    <p class="mb-0">
                        Hãy kiểm tra kỹ email, vai trò, trạng thái xác minh và thông tin bảo mật trước khi lưu thay đổi.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-form-card">
        <form asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="UserId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 mb-4"></div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="form-section-block mb-4">
                        <div class="form-section-header mb-3">
                            <div class="form-section-icon">
                                <i class="bi bi-person-vcard"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Thông tin tài khoản</h5>
                                <p class="section-subtitle mb-0">
                                    Cập nhật thông tin cơ bản của người dùng.
                                </p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label">Họ tên</label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PasswordHash" class="form-label">Mật khẩu / PasswordHash</label>
                                <input asp-for="PasswordHash" type="text" class="form-control" />
                                <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Role" class="form-label">Vai trò</label>
                                <select asp-for="Role" class="form-select">
                                    <option value="">-- Chọn vai trò --</option>
                                    <option value="User">User</option>
                                    <option value="Consultant">Consultant</option>
                                    <option value="Admin">Admin</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CreatedAt" class="form-label">Ngày tạo</label>
                                <input asp-for="CreatedAt" type="datetime-local" class="form-control" />
                                <span asp-validation-for="CreatedAt" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Sex" class="form-label">Giới tính</label>
                                <select asp-for="Sex" class="form-select">
                                    <option value="true">Nam</option>
                                    <option value="false">Nữ</option>
                                </select>
                                <span asp-validation-for="Sex" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mt-3">
                                    <input asp-for="IsVerified" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsVerified" class="form-check-label">Đánh dấu đã xác minh</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section-block">
                        <div class="form-section-header mb-3">
                            <div class="form-section-icon">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Thông tin bảo mật</h5>
                                <p class="section-subtitle mb-0">
                                    Dùng cho xác minh hoặc hỗ trợ khôi phục tài khoản khi cần.
                                </p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="SecurityQuestion" class="form-label">Câu hỏi bảo mật</label>
                                <input asp-for="SecurityQuestion" class="form-control" />
                                <span asp-validation-for="SecurityQuestion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SecurityAnswer" class="form-label">Câu trả lời bảo mật</label>
                                <input asp-for="SecurityAnswer" class="form-control" />
                                <span asp-validation-for="SecurityAnswer" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="appointment-help-panel h-100 admin-side-panel">
                        <div class="mb-4">
                            <span class="badge-soft primary mb-3">
                                <i class="bi bi-person-circle"></i>
                                Xem nhanh tài khoản
                            </span>

                            <div class="admin-user-preview-card">
                                <div class="admin-user-preview-avatar">
                                    <i class="bi bi-person"></i>
                                </div>

                                <h5 class="fw-bold mb-1">
                                    @(string.IsNullOrWhiteSpace(Model.FullName) ? "Chưa có tên" : Model.FullName)
                                </h5>

                                <p class="section-subtitle mb-3">
                                    @(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa có email" : Model.Email)
                                </p>

                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    <span class="badge-soft primary">
                                        @(string.IsNullOrWhiteSpace(Model.Role) ? "Chưa có vai trò" : Model.Role)
                                    </span>

                                    <span class="badge-soft @(Model.IsVerified ? "success" : "warning")">
                                        @(Model.IsVerified ? "Đã xác minh" : "Chưa xác minh")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="appointment-tip-box">
                            <h6 class="fw-bold mb-2">
                                <i class="bi bi-lightbulb me-2"></i>Gợi ý cập nhật
                            </h6>
                            <p class="mb-2">- Giữ email là duy nhất trong hệ thống.</p>
                            <p class="mb-2">- Chỉ đổi vai trò khi thật sự cần thiết.</p>
                            <p class="mb-2">- Chỉ xác minh khi tài khoản đã đầy đủ thông tin.</p>
                            <p class="mb-0">- Nếu nhập lại mật khẩu, nên hash ở controller trước khi lưu.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-2"></i>Lưu thay đổi
                </button>

                <a asp-controller="Admin" asp-action="UserList" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}