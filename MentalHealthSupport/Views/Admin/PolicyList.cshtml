@model IEnumerable<MentalHealthSupport.Models.TermsAndPolicy>

@{
    ViewData["Title"] = "Quản lý chính sách";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-policy-list-page">
    <div class="admin-card mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-shield-check"></i>
                    Quản lý chính sách hệ thống
                </span>
                <h2 class="fw-bold mb-3">Danh sách chính sách</h2>
                <p class="admin-section-subtitle mb-0">
                    Theo dõi, chỉnh sửa và quản lý các nội dung chính sách, điều khoản và tài liệu hệ thống.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="admin-dashboard-highlight h-100">
                    <div class="admin-dashboard-highlight-icon">
                        <i class="bi bi-journal-plus"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Tạo chính sách mới</h5>
                    <p class="mb-3">
                        Thêm nhanh nội dung chính sách để cập nhật thông tin quan trọng cho người dùng.
                    </p>
                    <a asp-controller="Admin" asp-action="CreatePolicy" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Thêm chính sách
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card">
        <div class="admin-toolbar">
            <div>
                <h4 class="admin-section-title mb-1">Toàn bộ chính sách</h4>
                <p class="admin-section-subtitle">
                    Tổng số: <strong>@(Model?.Count() ?? 0)</strong> chính sách
                </p>
            </div>

            <a asp-controller="Admin" asp-action="CreatePolicy" class="btn btn-primary">
                <i class="bi bi-journal-plus me-2"></i>Thêm mới
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="admin-empty-state">
                <i class="bi bi-shield-check"></i>
                <h5 class="fw-bold">Chưa có chính sách nào</h5>
                <p class="mb-3">Hãy thêm chính sách đầu tiên để bắt đầu quản lý nội dung hệ thống.</p>
                <a asp-controller="Admin" asp-action="CreatePolicy" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Tạo chính sách
                </a>
            </div>
        }
        else
        {
            <div class="app-table-shell admin-table-shell desktop-policy-table">
                <div class="table-responsive">
                    <table class="table table-modern align-middle admin-policy-table">
                        <thead>
                            <tr>
                                <th>Loại chính sách</th>
                                <th>Nội dung</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Cập nhật lần cuối</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var policy in Model)
                            {
                                var statusClass = policy.IsActive ? "success" : "warning";
                                var statusText = policy.IsActive ? "Đang hiển thị" : "Ẩn";

                                <tr>
                                    <td>
                                        <div class="fw-bold">
                                            @(string.IsNullOrWhiteSpace(policy.PolicyType) ? "Chưa có loại" : policy.PolicyType)
                                        </div>
                                        <div class="section-subtitle small">ID: @policy.Id</div>
                                    </td>

                                    <td>
                                        <div class="content-preview admin-policy-excerpt">
                                            @(string.IsNullOrWhiteSpace(policy.Content) ? "Chưa có nội dung" : policy.Content)
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge-soft @statusClass">
                                            @statusText
                                        </span>
                                    </td>

                                    <td>
                                        <div class="admin-date-cell">
                                            @policy.CreatedDate.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-date-cell">
                                            @(policy.LastModifiedDate.HasValue
                                                ? policy.LastModifiedDate.Value.ToString("dd/MM/yyyy")
                                                : "Chưa cập nhật")
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-controller="Admin"
                                               asp-action="EditPolicy"
                                               asp-route-id="@policy.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square me-1"></i>Sửa
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="DeletePolicy"
                                                  asp-route-id="@policy.Id"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa chính sách này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash me-1"></i>Xóa
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="admin-policy-mobile-list d-md-none mt-4">
                @foreach (var policy in Model)
                {
                    var statusClass = policy.IsActive ? "success" : "warning";
                    var statusText = policy.IsActive ? "Đang hiển thị" : "Ẩn";

                    <div class="admin-mobile-card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h6 class="fw-bold mb-1">
                                    @(string.IsNullOrWhiteSpace(policy.PolicyType) ? "Chưa có loại" : policy.PolicyType)
                                </h6>
                                <div class="section-subtitle small">ID: @policy.Id</div>
                            </div>

                            <span class="badge-soft @statusClass">@statusText</span>
                        </div>

                        <div class="content-preview admin-policy-excerpt mb-3">
                            @(string.IsNullOrWhiteSpace(policy.Content) ? "Chưa có nội dung" : policy.Content)
                        </div>

                        <div class="admin-mobile-info-grid mb-3">
                            <div>
                                <div class="admin-mobile-label">Ngày tạo</div>
                                <div class="admin-mobile-value">
                                    @policy.CreatedDate.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                            <div>
                                <div class="admin-mobile-label">Cập nhật cuối</div>
                                <div class="admin-mobile-value">
                                    @(policy.LastModifiedDate.HasValue
                                        ? policy.LastModifiedDate.Value.ToString("dd/MM/yyyy")
                                        : "Chưa cập nhật")
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Admin"
                               asp-action="EditPolicy"
                               asp-route-id="@policy.Id"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </a>

                            <form asp-controller="Admin"
                                  asp-action="DeletePolicy"
                                  asp-route-id="@policy.Id"
                                  method="post"
                                  class="m-0"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa chính sách này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i>Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>