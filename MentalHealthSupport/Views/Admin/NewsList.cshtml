@model IEnumerable<MentalHealthSupport.Models.News>

@{
    ViewData["Title"] = "Quản lý tin tức";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-news-list-page">
    <div class="admin-card mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-newspaper"></i>
                    Quản lý nội dung tin tức
                </span>
                <h2 class="fw-bold mb-3">Danh sách bài viết</h2>
                <p class="admin-section-subtitle mb-0">
                    Theo dõi, chỉnh sửa và quản lý toàn bộ bài viết hiển thị trong hệ thống MentalHealthSupport.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="admin-dashboard-highlight h-100">
                    <div class="admin-dashboard-highlight-icon">
                        <i class="bi bi-file-earmark-plus"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Tạo bài viết mới</h5>
                    <p class="mb-3">
                        Thêm nhanh nội dung mới để cập nhật thông tin cho người dùng.
                    </p>
                    <a asp-controller="Admin" asp-action="CreateNews" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Thêm bài viết
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card">
        <div class="admin-toolbar">
            <div>
                <h4 class="admin-section-title mb-1">Toàn bộ bài viết</h4>
                <p class="admin-section-subtitle">
                    Tổng số: <strong>@(Model?.Count() ?? 0)</strong> bài viết
                </p>
            </div>

            <a asp-controller="Admin" asp-action="CreateNews" class="btn btn-primary">
                <i class="bi bi-file-earmark-plus me-2"></i>Thêm mới
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="admin-empty-state">
                <i class="bi bi-newspaper"></i>
                <h5 class="fw-bold">Chưa có bài viết nào</h5>
                <p class="mb-3">Hãy thêm bài viết đầu tiên để bắt đầu quản lý nội dung tin tức.</p>
                <a asp-controller="Admin" asp-action="CreateNews" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Tạo bài viết
                </a>
            </div>
        }
        else
        {
            <div class="app-table-shell admin-table-shell desktop-news-table">
                <div class="table-responsive">
                    <table class="table table-modern align-middle admin-news-table">
                        <thead>
                            <tr>
                                <th>Tiêu đề</th>
                                <th>Nội dung</th>
                                <th>Tác giả</th>
                                <th>Ngày tạo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var news in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">
                                            @(string.IsNullOrWhiteSpace(news.Title) ? "Chưa có tiêu đề" : news.Title)
                                        </div>
                                    </td>

                                    <td>
                                        <div class="content-preview admin-news-excerpt">
                                            @(string.IsNullOrWhiteSpace(news.Content)
                                                ? "Chưa có nội dung"
                                                : news.Content)
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-date-cell">
                                            @(string.IsNullOrWhiteSpace(news.Author) ? "Chưa cập nhật" : news.Author)
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-date-cell">
                                            @news.CreatedDate.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-controller="Admin"
                                               asp-action="EditNews"
                                               asp-route-id="@news.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square me-1"></i>Sửa
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="DeleteNews"
                                                  asp-route-id="@news.Id"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash me-1"></i>Xóa
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="admin-news-mobile-list d-md-none mt-4">
                @foreach (var news in Model)
                {
                    <div class="admin-mobile-card">
                        <div class="mb-3">
                            <h6 class="fw-bold mb-1">
                                @(string.IsNullOrWhiteSpace(news.Title) ? "Chưa có tiêu đề" : news.Title)
                            </h6>
                            <div class="section-subtitle small mb-2">
                                @news.CreatedDate.ToString("dd/MM/yyyy")
                            </div>
                            <div class="admin-mobile-label mb-1">Tác giả</div>
                            <div class="admin-mobile-value mb-2">
                                @(string.IsNullOrWhiteSpace(news.Author) ? "Chưa cập nhật" : news.Author)
                            </div>
                            <div class="content-preview admin-news-excerpt">
                                @(string.IsNullOrWhiteSpace(news.Content)
                                    ? "Chưa có nội dung"
                                    : news.Content)
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Admin"
                               asp-action="EditNews"
                               asp-route-id="@news.Id"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </a>

                            <form asp-controller="Admin"
                                  asp-action="DeleteNews"
                                  asp-route-id="@news.Id"
                                  method="post"
                                  class="m-0"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i>Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>