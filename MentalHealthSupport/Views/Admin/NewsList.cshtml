@model List<MentalHealthSupport.Models.News>

@{
    ViewData["Title"] = "Danh Sách Tin Tức";
    Layout = null;
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
<!-- Custom CSS -->
<link rel="stylesheet" href="~/css/newslist.css" />

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">📰 Danh Sách Tin Tức</h1>
        <div>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-back"><i class="fas fa-arrow-left me-2"></i>Trở Về</a>
            <a asp-action="CreateNews" class="btn btn-primary ms-2"><i class="fas fa-plus me-2"></i>Thêm Tin Tức Mới</a>
        </div>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var news in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@news.Title</h5>
                        <p class="card-text mb-2"><i class="fas fa-user me-2"></i>Đăng bởi: @news.Author | <i class="fas fa-clock me-2"></i>@news.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                        <p class="card-text">@(news.Content.Length > 150 ? news.Content.Substring(0, 150) + "..." : news.Content)</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-end">
                        <a asp-action="EditNews" asp-route-id="@news.Id" class="btn btn-warning btn-sm ms-2"><i class="fas fa-edit me-1"></i>Sửa</a>
                        <a asp-action="DeleteNews" asp-route-id="@news.Id" class="btn btn-danger btn-sm ms-2" onclick="return confirm('Bạn có chắc muốn xóa?')"><i class="fas fa-trash me-1"></i>Xóa</a>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (Model.Count == 0)
    {
        <div class="text-center mt-4">
            <p class="no-data"><i class="fas fa-exclamation-circle me-2"></i>Không có tin tức nào để hiển thị.</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}