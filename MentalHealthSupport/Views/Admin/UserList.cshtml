@model IEnumerable<MentalHealthSupport.Models.User>

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-user-list-page">
    <div class="admin-card mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-people"></i>
                    Quản lý tài khoản hệ thống
                </span>
                <h2 class="fw-bold mb-3">Danh sách người dùng</h2>
                <p class="admin-section-subtitle mb-0">
                    Theo dõi, chỉnh sửa và quản lý các tài khoản đang hoạt động trong hệ thống MentalHealthSupport.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="admin-dashboard-highlight h-100">
                    <div class="admin-dashboard-highlight-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Tạo tài khoản mới</h5>
                    <p class="mb-3">
                        Thêm nhanh người dùng mới để mở rộng dữ liệu hệ thống.
                    </p>
                    <a asp-controller="Admin" asp-action="CreateUser" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Thêm người dùng
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 mb-4">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <div class="admin-card">
        <div class="admin-toolbar">
            <div>
                <h4 class="admin-section-title mb-1">Toàn bộ tài khoản</h4>
                <p class="admin-section-subtitle">
                    Tổng số: <strong>@(Model?.Count() ?? 0)</strong> người dùng
                </p>
            </div>

            <a asp-controller="Admin" asp-action="CreateUser" class="btn btn-primary">
                <i class="bi bi-person-plus me-2"></i>Thêm mới
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="admin-empty-state">
                <i class="bi bi-people"></i>
                <h5 class="fw-bold">Chưa có người dùng nào</h5>
                <p class="mb-3">Hãy thêm tài khoản đầu tiên để bắt đầu quản lý dữ liệu người dùng.</p>
                <a asp-controller="Admin" asp-action="CreateUser" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Tạo người dùng
                </a>
            </div>
        }
        else
        {
            <div class="app-table-shell admin-table-shell desktop-user-table">
                <div class="table-responsive">
                    <table class="table table-modern align-middle admin-user-table">
                        <thead>
                            <tr>
                                <th>Người dùng</th>
                                <th>Email</th>
                                <th>Vai trò</th>
                                <th>Số điện thoại</th>
                                <th>Ngày tạo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                var roleClass = user.Role == "Admin"
                                    ? "danger"
                                    : user.Role == "Consultant"
                                        ? "primary"
                                        : "success";

                                <tr>
                                    <td>
                                        <div class="admin-user-cell">
                                            <div class="admin-user-cell-avatar">
                                                <i class="bi bi-person-circle"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">@user.FullName</div>
                                                <div class="section-subtitle small">ID: @user.UserId</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-email-cell">@user.Email</div>
                                    </td>

                                    <td>
                                        <span class="badge-soft @roleClass">
                                            @user.Role
                                        </span>
                                    </td>

                                    <td>
                                        <div class="admin-phone-cell">
                                            @(string.IsNullOrWhiteSpace(user.Phone) ? "Chưa cập nhật" : user.Phone)
                                        </div>
                                    </td>

                                    <td>
                                        <div class="admin-date-cell">
                                            @user.CreatedAt.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-controller="Admin"
                                               asp-action="EditUser"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil-square me-1"></i>Sửa
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="DeleteUser"
                                                  asp-route-id="@user.UserId"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    <i class="bi bi-trash me-1"></i>Xóa
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="admin-user-mobile-list d-md-none mt-4">
                @foreach (var user in Model)
                {
                    var roleClass = user.Role == "Admin"
                        ? "danger"
                        : user.Role == "Consultant"
                            ? "primary"
                            : "success";

                    <div class="admin-mobile-card">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="admin-user-cell-avatar">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">@user.FullName</h6>
                                    <div class="section-subtitle small">@user.Email</div>
                                </div>
                            </div>

                            <span class="badge-soft @roleClass">@user.Role</span>
                        </div>

                        <div class="admin-mobile-info-grid mb-3">
                            <div>
                                <div class="admin-mobile-label">Số điện thoại</div>
                                <div class="admin-mobile-value">
                                    @(string.IsNullOrWhiteSpace(user.Phone) ? "Chưa cập nhật" : user.Phone)
                                </div>
                            </div>

                            <div>
                                <div class="admin-mobile-label">Ngày tạo</div>
                                <div class="admin-mobile-value">
                                    @user.CreatedAt.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Admin"
                               asp-action="EditUser"
                               asp-route-id="@user.UserId"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </a>

                            <form asp-controller="Admin"
                                  asp-action="DeleteUser"
                                  asp-route-id="@user.UserId"
                                  method="post"
                                  class="m-0"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa người dùng này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i>Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>