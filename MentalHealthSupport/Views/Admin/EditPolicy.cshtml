@model MentalHealthSupport.Models.TermsAndPolicy

@{
    ViewData["Title"] = "Chỉnh sửa Điều khoản/Chính sách";
    Layout = null;
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
<!-- Custom CSS -->
<link rel="stylesheet" href="~/css/editpolicy.css" />

<div class="container">
    <div class="card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="form-title">Chỉnh sửa Điều khoản/Chính sách</h2>
            <a href="javascript:history.back()" class="btn btn-back"><i class="fas fa-arrow-left me-2"></i>Trở Về</a>
        </div>
        <form asp-action="EditPolicy" asp-controller="Admin" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />
            <div class="form-group">
                <label asp-for="PolicyType" class="form-label">Loại</label>
                <input asp-for="PolicyType" class="form-control" readonly />
                <span asp-validation-for="PolicyType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Content" class="form-label">Nội dung</label>
                <textarea asp-for="Content" class="form-control" rows="8" placeholder="Nhập nội dung" required></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsActive" class="form-label">Trạng thái</label>
                <select asp-for="IsActive" class="form-select" required>
                    @{
                    var isActiveSelected = Model.IsActive ? "selected" : "";
                    var isInactiveSelected = !Model.IsActive ? "selected" : "";
                }
                <option value="true" isActiveSelected>Hoạt động</option>
                <option value="false" isInactiveSelected>Không hoạt động</option>
                </select>
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>
            <div class="btn-group">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Cập nhật</button>
                <a asp-action="PolicyList" asp-controller="Admin" class="btn btn-secondary"><i class="fas fa-times me-2"></i>Hủy</a>
            </div>
        </form>
        <div class="meta-info">
            <p>Ngày tạo: @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
            @if (Model.LastModifiedDate.HasValue)
            {
                <p>Ngày chỉnh sửa: @Model.LastModifiedDate.Value.ToString("dd/MM/yyyy")</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}