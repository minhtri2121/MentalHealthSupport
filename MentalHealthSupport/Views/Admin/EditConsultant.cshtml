@model MentalHealthSupport.ViewModels.ConsultantEditViewModel

@{
    ViewData["Title"] = "Sửa Thông Tin Chuyên Gia";
    Layout = null;
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
<!-- Custom CSS -->
<link rel="stylesheet" href="~/css/editconsultant.css" />

<div class="container">
    <div class="card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="form-title">Sửa Thông Tin Chuyên Gia</h2>
            <a href="javascript:history.back()" class="btn btn-back"><i class="fas fa-arrow-left me-2"></i>Trở Về</a>
        </div>
        <form asp-action="EditConsultant" asp-controller="Admin" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
            <input type="hidden" asp-for="UserId" />
            <div class="form-group">
                <label asp-for="FullName" class="form-label">Họ và Tên</label>
                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Nhập email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Phone" class="form-label">Số Điện Thoại</label>
                <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sex" class="form-label">Giới Tính</label>
                <select asp-for="Sex" class="form-select">
                    <option value="">Chọn giới tính</option>
                    <option value="true" selected="@(Model.Sex == true)">Nam</option>
                    <option value="false" selected="@(Model.Sex == false)">Nữ</option>
                </select>
                <span asp-validation-for="Sex" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SecurityQuestion" class="form-label">Câu Hỏi Bảo Mật</label>
                <input asp-for="SecurityQuestion" class="form-control" placeholder="Nhập câu hỏi bảo mật" required />
                <span asp-validation-for="SecurityQuestion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SecurityAnswer" class="form-label">Câu Trả Lời Bảo Mật</label>
                <input asp-for="SecurityAnswer" class="form-control" placeholder="Nhập câu trả lời" required />
                <span asp-validation-for="SecurityAnswer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Specialty" class="form-label">Chuyên Ngành</label>
                <input asp-for="Specialty" class="form-control" placeholder="Nhập chuyên ngành" required />
                <span asp-validation-for="Specialty" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExperienceYears" class="form-label">Số Năm Kinh Nghiệm</label>
                <input asp-for="ExperienceYears" type="number" class="form-control" min="0" step="1" placeholder="Nhập số năm kinh nghiệm" />
                <span asp-validation-for="ExperienceYears" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="form-label">Mô Tả</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ApprovalStatus" class="form-label">Trạng Thái Phê Duyệt</label>
                <select asp-for="ApprovalStatus" class="form-select">
                    <option value="Pending" selected="@(Model.ApprovalStatus == "Pending")">Chờ duyệt</option>
                    <option value="Approved" selected="@(Model.ApprovalStatus == "Approved")">Đã duyệt</option>
                    <option value="Rejected" selected="@(Model.ApprovalStatus == "Rejected")">Bị từ chối</option>
                </select>
                <span asp-validation-for="ApprovalStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CertificateUrl" class="form-label">URL Chứng Chỉ</label>
                <input asp-for="CertificateUrl" class="form-control" placeholder="Nhập URL chứng chỉ" />
                <span asp-validation-for="CertificateUrl" class="text-danger"></span>
            </div>
            <div class="btn-group">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Cập Nhật</button>
                <a asp-action="ConsultantList" asp-controller="Admin" class="btn btn-secondary"><i class="fas fa-times me-2"></i>Hủy</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    </script>
}