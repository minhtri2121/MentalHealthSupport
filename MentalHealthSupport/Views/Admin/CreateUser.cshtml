@model MentalHealthSupport.Models.User

@{
    ViewData["Title"] = "Thêm người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-create-user-page">
    <div class="admin-card mb-4">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-person-plus"></i>
                    Tạo tài khoản mới
                </span>
                <h2 class="fw-bold mb-3">Thêm người dùng</h2>
                <p class="admin-section-subtitle mb-0">
                    Điền thông tin cơ bản, vai trò và bảo mật để tạo tài khoản mới trong hệ thống MentalHealthSupport.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="admin-dashboard-highlight h-100">
                    <div class="admin-dashboard-highlight-icon">
                        <i class="bi bi-info-circle"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Lưu ý</h5>
                    <p class="mb-0">
                        Hãy kiểm tra đúng email, vai trò và thông tin bảo mật trước khi lưu tài khoản mới.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-form-card">
        <form asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 mb-4"></div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="form-section-block mb-4">
                        <div class="form-section-header mb-3">
                            <div class="form-section-icon">
                                <i class="bi bi-person-vcard"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Thông tin tài khoản</h5>
                                <p class="section-subtitle mb-0">Các thông tin cơ bản dùng để đăng nhập và hiển thị người dùng.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label">Họ tên</label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PasswordHash" class="form-label">Mật khẩu</label>
                                <input asp-for="PasswordHash" type="password" class="form-control" />
                                <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Role" class="form-label">Vai trò</label>
                                <select asp-for="Role" class="form-select">
                                    <option value="">-- Chọn vai trò --</option>
                                    <option value="User">User</option>
                                    <option value="Consultant">Consultant</option>
                                    <option value="Admin">Admin</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>

                            <input asp-for="CreatedAt" type="hidden" />

                            <div class="col-md-6">
                                <label asp-for="Sex" class="form-label">Giới tính</label>
                                <select asp-for="Sex" class="form-select">
                                    <option value="true">Nam</option>
                                    <option value="false">Nữ</option>
                                </select>
                                <span asp-validation-for="Sex" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mt-3">
                                    <input asp-for="IsVerified" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsVerified" class="form-check-label">Đánh dấu đã xác minh</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-section-block">
                        <div class="form-section-header mb-3">
                            <div class="form-section-icon">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Thông tin bảo mật</h5>
                                <p class="section-subtitle mb-0">Dùng cho hỗ trợ xác minh hoặc khôi phục tài khoản khi cần.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="SecurityQuestion" class="form-label">Câu hỏi bảo mật</label>
                                <input asp-for="SecurityQuestion" class="form-control" />
                                <span asp-validation-for="SecurityQuestion" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SecurityAnswer" class="form-label">Câu trả lời bảo mật</label>
                                <input asp-for="SecurityAnswer" class="form-control" />
                                <span asp-validation-for="SecurityAnswer" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="appointment-help-panel h-100 admin-side-panel">
                        <div class="mb-4">
                            <span class="badge-soft primary mb-3">
                                <i class="bi bi-person-circle"></i>
                                Xem nhanh
                            </span>

                            <div class="admin-user-preview-card">
                                <div class="admin-user-preview-avatar">
                                    <i class="bi bi-person"></i>
                                </div>
                                <h5 class="fw-bold mb-1">Tài khoản mới</h5>
                                <p class="section-subtitle mb-3">Thông tin sẽ được tạo sau khi lưu.</p>

                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    <span class="badge-soft primary">Vai trò linh hoạt</span>
                                    <span class="badge-soft warning">Chưa xác minh</span>
                                </div>
                            </div>
                        </div>

                        <div class="appointment-tip-box">
                            <h6 class="fw-bold mb-2">
                                <i class="bi bi-lightbulb me-2"></i>Gợi ý nhập liệu
                            </h6>
                            <p class="mb-2">- Email nên là duy nhất trong hệ thống.</p>
                            <p class="mb-2">- Mật khẩu nên đủ mạnh và dễ quản lý nội bộ.</p>
                            <p class="mb-2">- Chọn đúng vai trò để tránh sai quyền truy cập.</p>
                            <p class="mb-0">- Chỉ xác minh khi thông tin tài khoản đã đầy đủ.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>Tạo người dùng
                </button>

                <a asp-controller="Admin" asp-action="UserList" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}