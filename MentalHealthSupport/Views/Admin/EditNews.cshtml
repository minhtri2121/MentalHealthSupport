@model MentalHealthSupport.Models.News

@{
    ViewData["Title"] = "Sửa Tin Tức";
    Layout = null;
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
<!-- Custom CSS -->
<link rel="stylesheet" href="~/css/editnews.css" />

<div class="container">
    <div class="card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="form-title">Sửa Tin Tức</h2>
            <a href="javascript:history.back()" class="btn btn-back"><i class="fas fa-arrow-left me-2"></i>Trở Về</a>
        </div>
        <form asp-action="EditNews" method="post" class="needs-validation" novalidate>
            <input asp-for="Id" type="hidden" />
            <div class="form-group">
                <label asp-for="Title" class="form-label">Tiêu đề</label>
                <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề tin tức" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Content" class="form-label">Nội dung</label>
                <textarea asp-for="Content" class="form-control" rows="8" placeholder="Nhập nội dung tin tức" required></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="btn-group">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Lưu</button>
                <a asp-action="NewsList" class="btn btn-secondary"><i class="fas fa-times me-2"></i>Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}