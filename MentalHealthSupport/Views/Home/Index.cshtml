@{
    ViewData["Title"] = "Trang Chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<MentalHealthSupport.Models.ViewModel.ConsultantViewModel>

<section class="section-shell">
    <div class="container">
        <div class="hero-card p-4 p-lg-5 mb-5 home-hero">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-heart-pulse"></i>
                        Đồng hành cùng sức khỏe tinh thần
                    </span>

                    <h1 class="display-5 fw-bold mb-3">
                        Chăm sóc sức khỏe tâm lý theo cách an toàn, hiện đại và dễ tiếp cận.
                    </h1>

                    <p class="fs-5 section-subtitle mb-4">
                        Kết nối với chuyên gia phù hợp, đặt lịch nhanh, trò chuyện thuận tiện
                        và nhận hỗ trợ đáng tin cậy ngay trên nền tảng.
                    </p>

                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <a asp-controller="Consultants" asp-action="Index" class="btn btn-primary btn-lg">
                            Tìm chuyên gia
                        </a>
                        <a asp-controller="About" asp-action="Index" class="btn btn-outline-primary btn-lg">
                            Tìm hiểu thêm
                        </a>
                    </div>

                    <div class="row g-3 hero-mini-stats">
                        <div class="col-6 col-md-4">
                            <div class="hero-stat-card">
                                <h4>24/7</h4>
                                <p>Hỗ trợ trực tuyến</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="hero-stat-card">
                                <h4>Bảo mật</h4>
                                <p>Thông tin an toàn</p>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="hero-stat-card">
                                <h4>Nhanh</h4>
                                <p>Đặt lịch dễ dàng</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 text-center">
                    <div class="hero-image-wrap">
                        <img src="~/images/empathy-Photoroom.png"
                             asp-append-version="true"
                             alt="Hỗ trợ tâm lý"
                             class="img-fluid hero-main-image" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="feature-card p-4 text-center h-100">
                    <div class="feature-icon mx-auto mb-3">
                        <i class="fas fa-user-md"></i>
                    </div>
                    <h4 class="fw-bold">Chuyên gia chất lượng</h4>
                    <p class="section-subtitle mb-0">
                        Hồ sơ rõ ràng, chuyên môn cụ thể, dễ lựa chọn theo nhu cầu của người dùng.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card p-4 text-center h-100">
                    <div class="feature-icon mx-auto mb-3">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h4 class="fw-bold">Đặt lịch nhanh</h4>
                    <p class="section-subtitle mb-0">
                        Giao diện tối giản, quy trình ngắn gọn, phù hợp cả trên điện thoại lẫn máy tính.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card p-4 text-center h-100">
                    <div class="feature-icon mx-auto mb-3">
                        <i class="fas fa-shield-heart"></i>
                    </div>
                    <h4 class="fw-bold">Riêng tư và an toàn</h4>
                    <p class="section-subtitle mb-0">
                        Thông tin cá nhân và nội dung hỗ trợ được trình bày trong trải nghiệm tin cậy hơn.
                    </p>
                </div>
            </div>
        </div>

        <div class="page-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h2 class="section-title mb-2">Quy trình 3 bước</h2>
                <p class="section-subtitle">
                    Tìm chuyên gia, đặt lịch và bắt đầu buổi tư vấn một cách đơn giản.
                </p>
            </div>
            <a asp-controller="Consultants" asp-action="Index" class="btn btn-outline-primary">
                Bắt đầu ngay
            </a>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-4">
                <div class="feature-card p-4 h-100 process-card">
                    <div class="icon-badge mb-3">01</div>
                    <h5 class="fw-bold">Tìm chuyên gia</h5>
                    <p class="section-subtitle mb-0">
                        Lọc theo chuyên môn, kinh nghiệm và mức độ phù hợp với nhu cầu của bạn.
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="feature-card p-4 h-100 process-card">
                    <div class="icon-badge mb-3">02</div>
                    <h5 class="fw-bold">Đặt lịch</h5>
                    <p class="section-subtitle mb-0">
                        Chọn thời gian tư vấn và ghi chú ngắn để chuyên gia hiểu trước nhu cầu.
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="feature-card p-4 h-100 process-card">
                    <div class="icon-badge mb-3">03</div>
                    <h5 class="fw-bold">Nhận hỗ trợ</h5>
                    <p class="section-subtitle mb-0">
                        Theo dõi lịch hẹn và trao đổi thuận tiện trong hệ thống.
                    </p>
                </div>
            </div>
        </div>

        <div class="page-hero mb-4">
            <h2 class="section-title mb-2">Chuyên gia nổi bật</h2>
            <p class="section-subtitle mb-0">
                Những hồ sơ được hiển thị nổi bật để người dùng dễ bắt đầu hành trình.
            </p>
        </div>

        <div class="row g-4 mb-5">
            @if (Model != null && Model.Count > 0)
            {
                foreach (var consultant in Model)
                {
                    <div class="col-md-6 col-xl-3">
                        <div class="consultant-card p-4 h-100 d-flex flex-column">
                            <div class="text-center mb-3">
                                <img src="@(string.IsNullOrEmpty(consultant.AvatarUrl)
                                                ? Url.Content("~/images/default-avatar.png")
                                                : Url.Content("~/images/" + consultant.AvatarUrl))"
                                     alt="@consultant.FullName"
                                     class="consultant-avatar consultant-avatar-lg" />
                            </div>

                            <div class="text-center mb-3">
                                <h5 class="fw-bold mb-1">@consultant.FullName</h5>
                                <div class="section-subtitle">@consultant.Specialty</div>
                            </div>

                            <div class="d-flex justify-content-center mb-3">
                                <span class="badge-soft primary">
                                    <i class="bi bi-briefcase"></i>
                                    @consultant.ExperienceYears năm kinh nghiệm
                                </span>
                            </div>

                            <p class="section-subtitle text-center mb-4">
                                @(string.IsNullOrWhiteSpace(consultant.Description)
                                    ? "Chuyên gia luôn sẵn sàng đồng hành và hỗ trợ người dùng."
                                    : (consultant.Description.Length > 100
                                        ? consultant.Description.Substring(0, 100) + "..."
                                        : consultant.Description))
                            </p>

                            <div class="mt-auto d-grid">
                                <a asp-controller="Consultants"
                                   asp-action="Details"
                                   asp-route-id="@consultant.ConsultantId"
                                   class="btn btn-outline-primary">
                                    Xem hồ sơ
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-people"></i>
                        </div>
                        <h5 class="fw-bold">Chưa có chuyên gia nào được hiển thị</h5>
                        <p class="mb-0">
                            Bạn có thể thêm dữ liệu chuyên gia từ trang quản trị để làm nổi bật khu vực này.
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="home-cta-section">
            <div class="app-card p-4 p-lg-5 text-center">
                <span class="badge-soft primary mb-3">
                    <i class="bi bi-stars"></i>
                    Sẵn sàng bắt đầu?
                </span>
                <h2 class="section-title mb-3">
                    Hành trình chăm sóc sức khỏe tinh thần có thể bắt đầu ngay hôm nay.
                </h2>
                <p class="section-subtitle mb-4 mx-auto home-cta-text">
                    Chọn chuyên gia phù hợp và đặt lịch trong vài bước đơn giản để nhận được sự hỗ trợ bạn cần.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Consultants" asp-action="Index" class="btn btn-primary btn-lg">
                        Xem chuyên gia
                    </a>
                    <a asp-controller="News" asp-action="Index" class="btn btn-outline-primary btn-lg">
                        Xem bài viết
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const cards = document.querySelectorAll(".consultant-card, .feature-card, .hero-stat-card");
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.05}s`;
                card.classList.add("fade-in-up");
            });
        });
    </script>
}