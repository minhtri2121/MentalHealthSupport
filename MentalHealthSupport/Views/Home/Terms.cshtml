@model MentalHealthSupport.Models.TermsAndPolicy

@{
    ViewData["Title"] = "Điều khoản dịch vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-shell">
    <div class="container">
        <div class="page-hero legal-page-hero mb-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-file-earmark-check"></i>
                        Quy định sử dụng
                    </span>
                    <h1 class="mb-3">Điều khoản dịch vụ</h1>
                    <p class="mb-0">
                        Các điều khoản này giúp người dùng hiểu rõ quyền lợi, trách nhiệm và phạm vi sử dụng dịch vụ trên nền tảng.
                    </p>
                </div>

                <div class="col-lg-4">
                    <div class="legal-side-note">
                        <h5>Lưu ý</h5>
                        <p class="mb-0">
                            Vui lòng đọc kỹ điều khoản trước khi sử dụng để đảm bảo trải nghiệm an toàn và phù hợp.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card legal-content-card p-4 p-lg-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Nội dung điều khoản</h4>
                    <p class="section-subtitle mb-0">
                        Các quy định áp dụng khi người dùng truy cập và sử dụng hệ thống.
                    </p>
                </div>

                <a href="javascript:history.back()" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </a>
            </div>

            <div class="legal-content-body">
                @if (Model == null || string.IsNullOrWhiteSpace(Model.Content))
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <h5 class="fw-bold">Chưa có nội dung điều khoản</h5>
                        <p class="mb-0">Hiện tại chưa có dữ liệu để hiển thị.</p>
                    </div>
                }
                else
                {
                    @Html.Raw(Model.Content)
                }
            </div>

            <div class="legal-meta mt-4 pt-4">
                @if (Model?.LastModifiedDate.HasValue == true)
                {
                    <div class="legal-meta-item">
                        <i class="bi bi-clock-history"></i>
                        <span>Cập nhật lần cuối: @Model.LastModifiedDate.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>