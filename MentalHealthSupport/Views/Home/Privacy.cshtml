@model MentalHealthSupport.Models.TermsAndPolicy

@{
    ViewData["Title"] = "Chính sách bảo mật";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-shell">
    <div class="container">
        <div class="page-hero legal-page-hero mb-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-shield-lock"></i>
                        Chính sách hệ thống
                    </span>
                    <h1 class="mb-3">Chính sách bảo mật</h1>
                    <p class="mb-0">
                        Chúng tôi cam kết bảo vệ thông tin cá nhân, dữ liệu trao đổi và quyền riêng tư của người dùng khi sử dụng hệ thống.
                    </p>
                </div>

                <div class="col-lg-4">
                    <div class="legal-side-note">
                        <h5>Thông tin cập nhật</h5>
                        <p class="mb-0">
                            Nội dung chính sách được trình bày rõ ràng để người dùng dễ theo dõi và yên tâm sử dụng dịch vụ.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card legal-content-card p-4 p-lg-5">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h4 class="fw-bold mb-1">Nội dung chính sách</h4>
                    <p class="section-subtitle mb-0">
                        Các điều khoản liên quan đến quyền riêng tư và bảo mật thông tin.
                    </p>
                </div>

                <a href="javascript:history.back()" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Quay lại
                </a>
            </div>

            <div class="legal-content-body">
                @if (Model == null || string.IsNullOrWhiteSpace(Model.Content))
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <h5 class="fw-bold">Chưa có nội dung chính sách</h5>
                        <p class="mb-0">Hiện tại chưa có dữ liệu để hiển thị.</p>
                    </div>
                }
                else
                {
                    @Html.Raw(Model.Content)
                }
            </div>

            <div class="legal-meta mt-4 pt-4">
                @if (Model?.LastModifiedDate.HasValue == true)
                {
                    <div class="legal-meta-item">
                        <i class="bi bi-clock-history"></i>
                        <span>Cập nhật lần cuối: @Model.LastModifiedDate.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>