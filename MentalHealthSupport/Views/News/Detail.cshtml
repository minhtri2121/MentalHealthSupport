@model MentalHealthSupport.Models.News

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="mb-3">
        <a href="/News/Index" class="btn btn-outline-secondary rounded-pill px-4">
            ← Quay lại danh sách bài viết
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="text-muted mb-2">
                Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Author))
            {
                <div class="text-muted mb-4">
                    Tác giả: @Model.Author
                </div>
            }

            <h1 class="mb-4">@Model.Title</h1>

            <div style="white-space: pre-line; line-height: 1.9; font-size: 1.05rem;">
                @Model.Content
            </div>
        </div>
    </div>
</div>