@model List<MentalHealthSupport.Models.News>

@{
    ViewData["Title"] = "Tin tức";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-shell">
    <div class="container">
        <div class="page-hero news-page-hero mb-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-newspaper"></i>
                        Tin tức và kiến thức
                    </span>
                    <h1 class="mb-3">Sức khỏe tâm lý</h1>
                    <p class="mb-0">
                        Cập nhật thông tin, kiến thức và những nội dung hữu ích giúp người dùng hiểu hơn về sức khỏe tinh thần và cách chăm sóc bản thân.
                    </p>
                </div>

                <div class="col-lg-4">
                    <div class="news-side-note">
                        <div class="news-date-label">Hôm nay</div>
                        <h5 class="mb-2">@DateTime.Now.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</h5>
                        <p class="mb-0">@DateTime.Now.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</p>
                    </div>
                </div>
            </div>
        </div>

        @if (Context.Session.GetString("UserRole") == "Admin")
        {
            <div class="d-flex justify-content-end mb-4">
                <a asp-action="CreateNews" asp-controller="Admin" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Thêm tin tức mới
                </a>
            </div>
        }

        @if (Model != null && Model.Count > 0)
        {
            <div class="row g-4">
                @foreach (var news in Model)
                {
                    <div class="col-12">
                        <article class="app-card news-article-card p-4 p-lg-5">
                            <div class="news-article-header mb-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                    <div>
                                        <h2 class="news-article-title mb-2">@news.Title</h2>
                                        <div class="news-article-meta">
                                            <span><i class="bi bi-person-circle me-1"></i>@news.Author</span>
                                            <span><i class="bi bi-clock-history me-1"></i>@news.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    </div>

                                    <span class="badge-soft primary">
                                        <a href="/News/Detail/@news.Id">Xem chi tiết</a>
                                    </span>
                                </div>
                            </div>

                            <div class="news-article-content">
                                @foreach (var paragraph in (news.Content ?? string.Empty)
                                    .Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <p>@paragraph</p>
                                }
                            </div>

                            @if (Context.Session.GetString("UserRole") == "Admin")
                            {
                                <div class="news-article-actions mt-4 pt-3">
                                    <div class="d-flex flex-wrap gap-2">
                                        <a asp-action="EditNews"
                                           asp-controller="Admin"
                                           asp-route-id="@news.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil-square me-1"></i>Sửa
                                        </a>

                                        <form asp-action="DeleteNews"
                                              asp-controller="Admin"
                                              asp-route-id="@news.Id"
                                              method="post"
                                              class="m-0"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa bài viết này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i>Xóa
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-newspaper"></i>
                </div>
                <h5 class="fw-bold">Chưa có tin tức nào</h5>
                <p class="mb-0">Hiện tại chưa có tin tức để hiển thị.</p>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}