@model List<MentalHealthSupport.Models.News>
@{
    ViewData["Title"] = "Tin Tức";
}
<link rel="stylesheet" href="~/css/news.css" />

<div class="container-fluid px-4 py-5">
    <!-- Header báo -->
    <div class="newspaper-header text-center mb-5">
        <h1 class="newspaper-title">SỨC KHỎE TÂM LÝ</h1>
        <div class="newspaper-subtitle">Tin tức - Thông tin - Kiến thức</div>
        <div class="newspaper-date">@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</div>
        <hr class="newspaper-divider">
    </div>

    <!-- Nút thêm tin tức (chỉ hiển thị cho Admin) -->
    @if (Context.Session.GetString("Role") == "Admin")
    {
        <div class="admin-controls mb-4">
            <a asp-action="CreateNews" asp-controller="Admin" class="btn btn-admin">
                <i class="fas fa-plus"></i> Thêm Tin Tức Mới
            </a>
        </div>
    }

    @if (Model.Count > 0)
    {
        <!-- Danh sách tin tức -->
        <div class="news-list">
            @foreach (var news in Model)
            {
                <div class="news-article mb-5">
                    <div class="article-header">
                        <h2 class="article-title">@news.Title</h2>
                        <div class="article-meta">
                            <span class="author">Bởi @news.Author</span>
                            <span class="date">@news.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="article-content">
                        <p class="article-text">@news.Content</p>
                    </div>
                    @if (Context.Session.GetString("Role") == "Admin")
                    {
                        <div class="article-actions">
                            <div class="admin-actions">
                                <a asp-action="EditNews" asp-controller="Admin" asp-route-id="@news.Id" class="btn-edit">Sửa</a>
                                <a asp-action="DeleteNews" asp-controller="Admin" asp-route-id="@news.Id" class="btn-delete" onclick="return confirm('Bạn có chắc muốn xóa?')">Xóa</a>
                            </div>
                        </div>
                    }
                </div>
                @if (!Model.Last().Equals(news))
                {
                    <hr class="article-divider">
                }
            }
        </div>
    }
    else
    {
        <div class="no-news text-center">
            <h4>Chưa có tin tức nào</h4>
            <p class="text-muted">Hiện tại chưa có tin tức nào để hiển thị.</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}