@model List<MentalHealthSupport.Models.ViewModel.ConsultantViewModel>
@{
    ViewData["Title"] = "Đội ngũ chuyên gia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-shell">
    <div class="container">
        <div class="page-hero consultant-page-hero">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-person-heart"></i>
                        Đội ngũ tư vấn đồng hành cùng bạn
                    </span>
                    <h1 class="mb-3">Đội ngũ chuyên gia tâm lý</h1>
                    <p class="mb-0">
                        Chọn chuyên gia theo chuyên môn, số năm kinh nghiệm và mức độ phù hợp
                        với nhu cầu của bạn để bắt đầu hành trình hỗ trợ hiệu quả hơn.
                    </p>
                </div>
                <div class="col-lg-4">
                    <div class="consultant-summary-box">
                        <div class="consultant-summary-item">
                            <h3>@(Model?.Count ?? 0)</h3>
                            <p>Chuyên gia hiện có</p>
                        </div>
                        <div class="consultant-summary-item">
                            <h3>Nhanh</h3>
                            <p>Kết nối thuận tiện</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-search"></i></div>
                <h5 class="fw-bold">Hiện chưa có chuyên gia nào</h5>
                <p class="mb-0">
                    Vui lòng quay lại sau khi hệ thống được cập nhật thêm hồ sơ mới.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var consultant in Model)
                {
                    var shortDescription = string.IsNullOrWhiteSpace(consultant.Description)
                        ? "Chuyên gia sẵn sàng lắng nghe và đồng hành cùng bạn trong quá trình hỗ trợ tâm lý."
                        : (consultant.Description.Length > 135
                            ? consultant.Description.Substring(0, 135) + "..."
                            : consultant.Description);

                    <div class="col-md-6 col-xl-4">
                        <div class="consultant-card consultant-list-card p-4 h-100 d-flex flex-column">
                            <div class="consultant-card-top mb-3">
                                <div class="d-flex align-items-start gap-3">
                                    <img src="@(string.IsNullOrEmpty(consultant.AvatarUrl)
                                                    ? Url.Content("~/images/default-avatar.png")
                                                    : Url.Content("~/images/" + consultant.AvatarUrl))"
                                         alt="@consultant.FullName"
                                         class="consultant-avatar consultant-avatar-list" />

                                    <div class="flex-grow-1">
                                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold mb-0 consultant-name">@consultant.FullName</h5>

                                            @if (consultant.IsVerified)
                                            {
                                                <span class="badge-soft success">
                                                    <i class="bi bi-patch-check-fill"></i>
                                                    Đã xác minh
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-soft warning">
                                                    <i class="bi bi-hourglass-split"></i>
                                                    Chưa xác minh
                                                </span>
                                            }
                                        </div>

                                        <div class="consultant-specialty mb-2">
                                            @consultant.Specialty
                                        </div>

                                        <div class="d-flex flex-wrap gap-2">
                                            <span class="badge-soft primary">
                                                <i class="bi bi-briefcase"></i>
                                                @consultant.ExperienceYears năm
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(consultant.CertificateUrl))
                                            {
                                                <span class="badge-soft">
                                                    <i class="bi bi-award"></i>
                                                    Có chứng chỉ
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="consultant-card-body mb-4">
                                <p class="section-subtitle mb-0 consultant-desc">
                                    @shortDescription
                                </p>
                            </div>

                            <div class="consultant-card-bottom mt-auto">
                                <div class="d-grid gap-2">
                                    <a href="@Url.Action("Details", "Consultants", new { id = consultant.ConsultantId })"
                                       class="btn btn-outline-primary">
                                        <i class="bi bi-person-vcard me-2"></i>Xem chi tiết
                                    </a>

                                    <form asp-action="StartChat" asp-controller="Chat" method="post" class="m-0">
                                        <input type="hidden" name="consultantId" value="@consultant.ConsultantId" />
                                        <button type="submit" class="btn btn-primary w-100">
                                            <i class="bi bi-chat-dots me-2"></i>Liên hệ ngay
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>