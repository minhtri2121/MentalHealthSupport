@model MentalHealthSupport.Models.ViewModel.ConsultantDetailsViewModel
@{
    ViewData["Title"] = "Hồ sơ chuyên gia";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusClass = Model.ApprovalStatus == "Approved"
        ? "success"
        : Model.ApprovalStatus == "Pending"
            ? "warning"
            : "danger";

    var statusText = Model.ApprovalStatus == "Approved"
        ? "Đang hoạt động"
        : Model.ApprovalStatus == "Pending"
            ? "Đang chờ duyệt"
            : "Bị từ chối";
}

<section class="section-shell">
    <div class="container">
        <div class="page-hero consultant-detail-hero mb-4">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="badge-soft primary mb-3">
                        <i class="bi bi-person-vcard"></i>
                        Hồ sơ chuyên gia
                    </span>
                    <h1 class="mb-3">Thông tin chi tiết chuyên gia</h1>
                    <p class="mb-0">
                        Tìm hiểu chuyên môn, kinh nghiệm và hồ sơ xác minh trước khi bắt đầu liên hệ hoặc đặt lịch tư vấn.
                    </p>
                </div>
                <div class="col-lg-4">
                    <div class="consultant-detail-status-box">
                        <span class="badge-soft @statusClass">
                            <i class="bi bi-check2-circle"></i>
                            @statusText
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card p-4 p-lg-5 consultant-detail-shell">
            <div class="row g-4 align-items-start">
                <div class="col-lg-4">
                    <div class="consultant-profile-panel text-center">
                        <div class="consultant-detail-avatar-wrap mb-3">
                            <img src="@(string.IsNullOrEmpty(Model.AvatarUrl)
                                            ? Url.Content("~/images/default-avatar.png")
                                            : Url.Content("~/images/" + Model.AvatarUrl))"
                                 alt="@Model.FullName"
                                 class="consultant-detail-avatar mb-3" />
                        </div>

                        <h3 class="fw-bold mb-2">@Model.FullName</h3>

                        <div class="consultant-role-text mb-3">
                            @Model.Role
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
                            <span class="badge-soft @(Model.IsVerified ? "success" : "danger")">
                                <i class="bi bi-@(Model.IsVerified ? "patch-check-fill" : "x-circle-fill")"></i>
                                @(Model.IsVerified ? "Đã xác minh" : "Chưa xác minh")
                            </span>

                            <span class="badge-soft primary">
                                <i class="bi bi-briefcase"></i>
                                @Model.ExperienceYears năm
                            </span>
                        </div>

                        <div class="d-grid gap-2">
                            <form asp-action="StartChat" asp-controller="Chat" method="post" class="m-0">
                                <input type="hidden" name="consultantId" value="@Model.ConsultantId" />
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-chat-dots me-2"></i>Liên hệ tư vấn
                                </button>
                            </form>

                            <a asp-controller="Appointments"
                               asp-action="Create"
                               asp-route-consultantId="@Model.ConsultantId"
                               class="btn btn-outline-primary">
                                <i class="bi bi-calendar-plus me-2"></i>Đặt lịch tư vấn
                            </a>

                            <a asp-controller="Reviews"
                               asp-action="ConsultantReviews"
                               asp-route-consultantId="@Model.ConsultantId"
                               class="btn btn-secondary">
                                <i class="bi bi-star me-2"></i>Xem đánh giá
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="feature-card p-4 h-100 consultant-info-card">
                                <div class="consultant-info-label">Chuyên môn</div>
                                <div class="consultant-info-value">@Model.Specialty</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="feature-card p-4 h-100 consultant-info-card">
                                <div class="consultant-info-label">Kinh nghiệm</div>
                                <div class="consultant-info-value">@Model.ExperienceYears năm</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="feature-card p-4 h-100 consultant-info-card">
                                <div class="consultant-info-label">Bằng cấp / chứng chỉ</div>
                                <div class="consultant-info-value">
                                    @(string.IsNullOrWhiteSpace(Model.CertificateUrl) ? "Chưa cung cấp" : Model.CertificateUrl)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="feature-card p-4 h-100 consultant-info-card">
                                <div class="consultant-info-label">Trạng thái hồ sơ</div>
                                <div>
                                    <span class="badge-soft @statusClass">@statusText</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="app-card consultant-bio-card p-4 mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="icon-badge consultant-section-icon">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">Giới thiệu</h5>
                                <div class="section-subtitle">Thông tin mô tả và định hướng hỗ trợ</div>
                            </div>
                        </div>

                        <div class="policy-content consultant-bio-content">
                            @if (string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p class="mb-0">Chuyên gia hiện chưa cập nhật phần mô tả giới thiệu.</p>
                            }
                            else
                            {
                                <p class="mb-0">@Model.Description</p>
                            }
                        </div>
                    </div>

                    <div class="consultant-highlight-box">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="consultant-highlight-item">
                                    <div class="consultant-highlight-icon">
                                        <i class="bi bi-shield-check"></i>
                                    </div>
                                    <h6>Độ tin cậy</h6>
                                    <p class="mb-0">Hồ sơ rõ ràng, thông tin minh bạch và dễ theo dõi.</p>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="consultant-highlight-item">
                                    <div class="consultant-highlight-icon">
                                        <i class="bi bi-chat-heart"></i>
                                    </div>
                                    <h6>Hỗ trợ thuận tiện</h6>
                                    <p class="mb-0">Người dùng có thể liên hệ hoặc đặt lịch chỉ trong vài bước.</p>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="consultant-highlight-item">
                                    <div class="consultant-highlight-icon">
                                        <i class="bi bi-calendar2-week"></i>
                                    </div>
                                    <h6>Theo dõi dễ dàng</h6>
                                    <p class="mb-0">Lịch hẹn và trao đổi được quản lý tập trung trong hệ thống.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex flex-wrap gap-3">
                        <a asp-controller="Consultants" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
                        </a>

                        <a asp-controller="Appointments"
                           asp-action="Create"
                           asp-route-consultantId="@Model.ConsultantId"
                           class="btn btn-primary">
                            <i class="bi bi-calendar-check me-2"></i>Đặt lịch ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>